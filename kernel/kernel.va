let teal be rgb(55, 224, 200)
let violet be rgb(165, 120, 255)
let amber be rgb(245, 180, 70)
let coral be rgb(255, 105, 116)
let white be rgb(232, 238, 250)
let dim be rgb(150, 166, 198)
let ink be rgb(5, 8, 14)
let rim be rgb(120, 150, 205)
let glass_top be rgb(32, 37, 58)
let glass_bot be rgb(17, 20, 34)
let bar_top be rgb(44, 51, 80)
let bar_bot be rgb(30, 35, 56)
let hair be rgb(58, 68, 104)
let frost be rgb(24, 28, 48)

let sw be screen_w()
let sh be screen_h()
let dock_x be 16
let dock_y be 150
let dock_w be 64
let dock_h be 300
let tile_x be 26
let tile_w be 44
let tile_h be 44

let windows be []
add {"x": 168, "y": 84, "w": 470, "h": 250, "title": "Vanta Studio", "kind": "studio", "accent": teal, "open": 1} to windows
add {"x": 250, "y": 392, "w": 470, "h": 150, "title": "V-NOx Terminal", "kind": "term", "accent": violet, "open": 1} to windows
add {"x": 360, "y": 150, "w": 420, "h": 210, "title": "Files", "kind": "files", "accent": amber, "open": 0} to windows
add {"x": 420, "y": 220, "w": 400, "h": 200, "title": "About V-NOx", "kind": "about", "accent": coral, "open": 0} to windows
let buf be "> "
let drag be -1
let dox be 0
let doy be 0
let front be 0
let prevdown be 0

to tile_y(i)
    give back dock_y + 16 + i * 60
end

to dock_hit(my)
    let i be 0
    while i is at most 3
        let ty be tile_y(i)
        if my is at least ty and my is at most (ty + tile_h)
            give back i
        end
        change i to i + 1
    end
    give back -1
end

to shadowtext(x, y, s, c)
    text_at(x + 1, y + 1, s, ink)
    text_at(x, y, s, c)
end

to bigshadow(x, y, s, c)
    text_big(x + 2, y + 2, s, ink)
    text_big(x, y, s, c)
end

to draw_tile(i, glyph, col)
    let ty be tile_y(i)
    if windows[i]["open"] is 1
        rblend(tile_x - 5, ty - 5, tile_w + 10, tile_h + 10, col, 45, 13)
        fill(dock_x + 3, ty + 13, 3, 18, col)
    end
    rfill(tile_x, ty, tile_w, tile_h, col, 11)
    rblend(tile_x, ty, tile_w, 20, white, 28, 11)
    text_big(tile_x + 15, ty + 15, glyph, rgb(12, 16, 24))
end

to draw_window(w)
    let x be w["x"]
    let y be w["y"]
    let ww be w["w"]
    let hh be w["h"]
    shadow(x, y, ww, hh, 11)
    rgrad(x, y, ww, hh, glass_top, glass_bot, 11)
    rgradt(x, y, ww, 34, bar_top, bar_bot, 11)
    rblend(x, y, ww, 16, white, 16, 11)
    rborder(x, y, ww, hh, rim, 11)
    fill(x + 1, y + 34, ww - 2, 1, hair)
    rfill(x + 13, y + 12, 10, 10, w["accent"], 4)
    shadowtext(x + 32, y + 11, w["title"], white)
    rfill(x + ww - 30, y + 9, 18, 18, coral, 5)
    text_at(x + ww - 25, y + 11, "x", rgb(44, 8, 10))
    if w["kind"] is "studio"
        text_at(x + 18, y + 54, "to greet(name)", teal)
        text_at(x + 18, y + 74, "    say \"hi \" + name", white)
        text_at(x + 18, y + 94, "end", teal)
        text_at(x + 18, y + 128, "drag titles - X closes - dock opens apps", dim)
        text_at(x + 18, y + 150, "compiled from Vanta to native code,", dim)
        text_at(x + 18, y + 170, "running on bare metal. no python.", dim)
    end
    if w["kind"] is "term"
        text_at(x + 16, y + 54, buf, teal)
        text_at(x + 16, y + 104, "type on the keyboard - it echoes here", dim)
    end
    if w["kind"] is "files"
        text_at(x + 18, y + 54, "Documents/", amber)
        text_at(x + 18, y + 78, "welcome.va", white)
        text_at(x + 18, y + 98, "readme.txt", white)
        text_at(x + 18, y + 118, "notes.txt", white)
        text_at(x + 18, y + 152, "a files window (no disk yet)", dim)
    end
    if w["kind"] is "about"
        bigshadow(x + 18, y + 54, "V-NOx 1", teal)
        text_at(x + 18, y + 90, "the first desktop OS", white)
        text_at(x + 18, y + 108, "written in Vanta.", white)
        text_at(x + 18, y + 138, "kernel, mouse driver, windows -", dim)
        text_at(x + 18, y + 156, "all compiled from Vanta to native.", dim)
    end
end

wallpaper()
gc_mark()
while yes
    frame_reset()
    poll()
    let mx be mouse_x()
    let my be mouse_y()
    let down be mouse_down()
    let k be key()
    if k is not ""
        change buf to buf + k
    end
    if down is 1 and prevdown is 0
        let handled be 0
        if mx is at least (tile_x - 5) and mx is at most (tile_x + tile_w + 5)
            let di be dock_hit(my)
            if di is at least 0
                let dw be windows[di]
                change dw at "open" to 1
                change front to di
                change handled to 1
            end
        end
        let i be 0
        for each w in windows
            if w["open"] is 1 and handled is 0
                if mx is at least (w["x"] + w["w"] - 32) and mx is at most (w["x"] + w["w"] - 8) and my is at least (w["y"] + 7) and my is at most (w["y"] + 29)
                    change w at "open" to 0
                    change handled to 1
                otherwise if mx is at least w["x"] and mx is at most (w["x"] + w["w"]) and my is at least w["y"] and my is at most (w["y"] + 34)
                    change drag to i
                    change dox to mx - w["x"]
                    change doy to my - w["y"]
                    change front to i
                    change handled to 1
                end
            end
            change i to i + 1
        end
    end
    if down is 1 and drag is at least 0
        let w be windows[drag]
        change w at "x" to mx - dox
        change w at "y" to my - doy
    end
    if down is 0
        change drag to -1
    end
    change prevdown to down

    clear()
    rblend(0, 0, sw, 30, rgb(18, 22, 38), 175, 0)
    fill(0, 30, sw, 1, hair)
    bigshadow(16, 7, "V", teal)
    bigshadow(34, 7, "-NOx", white)
    text_at(sw - 248, 11, "bare metal  -  no python  -  no libc", dim)
    fill(sw - 30, 12, 7, 7, teal)
    fill(sw - 18, 12, 7, 7, violet)
    rblend(dock_x, dock_y, dock_w, dock_h, frost, 150, 18)
    rborder(dock_x, dock_y, dock_w, dock_h, rim, 18)
    draw_tile(0, "S", teal)
    draw_tile(1, ">", violet)
    draw_tile(2, "F", amber)
    draw_tile(3, "i", coral)
    let px be sw / 2 - 140
    rblend(px, sh - 46, 280, 32, frost, 165, 14)
    rborder(px, sh - 46, 280, 32, rim, 14)
    rfill(px + 9, sh - 40, 20, 20, teal, 6)
    text_at(px + 14, sh - 34, "V", rgb(8, 18, 16))
    shadowtext(px + 40, sh - 36, "V-NOx 1   the OS written in Vanta", dim)
    let i be 0
    for each w in windows
        if w["open"] is 1 and i is not front
            draw_window(w)
        end
        change i to i + 1
    end
    if windows[front]["open"] is 1
        draw_window(windows[front])
    end
    cursor(mx, my)
    present()
end
