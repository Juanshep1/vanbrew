let navy be rgb(20, 26, 46)
let accent be rgb(76, 141, 255)
let panelc be rgb(26, 33, 56)
let body be rgb(14, 20, 38)
let white be rgb(231, 238, 252)
let dim be rgb(150, 170, 210)
let titlefg be rgb(6, 18, 44)
let green be rgb(120, 230, 160)
let closec be rgb(220, 70, 90)

let sw be screen_w()
let sh be screen_h()

let windows be []
add {"x": 150, "y": 60, "w": 480, "h": 230, "title": "Vanta Studio", "kind": "studio", "open": 1} to windows
add {"x": 250, "y": 330, "w": 480, "h": 150, "title": "V-NOx Terminal", "kind": "term", "open": 1} to windows
add {"x": 320, "y": 120, "w": 420, "h": 200, "title": "Files", "kind": "files", "open": 0} to windows
add {"x": 360, "y": 170, "w": 400, "h": 180, "title": "About V-NOx", "kind": "about", "open": 0} to windows
let buf be "> "
let drag be -1
let dox be 0
let doy be 0
let front be 0
let prevdown be 0

to draw_window(w)
    fill(w["x"], w["y"], w["w"], w["h"], body)
    fill(w["x"], w["y"], w["w"], 30, accent)
    text_at(w["x"] + 12, w["y"] + 11, w["title"], titlefg)
    fill(w["x"] + w["w"] - 26, w["y"] + 7, 16, 16, closec)
    text_at(w["x"] + w["w"] - 21, w["y"] + 11, "x", white)
    if w["kind"] is "studio"
        text_at(w["x"] + 16, w["y"] + 50, "to greet(name)", white)
        text_at(w["x"] + 16, w["y"] + 70, "    say \"hi \" + name", white)
        text_at(w["x"] + 16, w["y"] + 90, "end", white)
        text_at(w["x"] + 16, w["y"] + 124, "drag titles, X to close,", dim)
        text_at(w["x"] + 16, w["y"] + 142, "click the dock to open apps.", dim)
        text_at(w["x"] + 16, w["y"] + 160, "no OS. no python. bare metal.", dim)
    end
    if w["kind"] is "term"
        text_at(w["x"] + 14, w["y"] + 50, buf, green)
        text_at(w["x"] + 14, w["y"] + 100, "(type on the keyboard)", dim)
    end
    if w["kind"] is "files"
        text_at(w["x"] + 16, w["y"] + 50, "Documents/", accent)
        text_at(w["x"] + 16, w["y"] + 72, "welcome.va", white)
        text_at(w["x"] + 16, w["y"] + 92, "readme.txt", white)
        text_at(w["x"] + 16, w["y"] + 112, "notes.txt", white)
        text_at(w["x"] + 16, w["y"] + 144, "(a files window)", dim)
    end
    if w["kind"] is "about"
        text_big(w["x"] + 16, w["y"] + 48, "V-NOx", accent)
        text_at(w["x"] + 16, w["y"] + 84, "the first OS desktop", white)
        text_at(w["x"] + 16, w["y"] + 102, "written in Vanta,", white)
        text_at(w["x"] + 16, w["y"] + 120, "running on bare metal.", white)
        text_at(w["x"] + 16, w["y"] + 146, "kernel, mouse, windows -", dim)
        text_at(w["x"] + 16, w["y"] + 164, "all compiled from Vanta.", dim)
    end
end

to dock_hit(my)
    if my is at least 130 and my is at most 166
        give back 0
    end
    if my is at least 176 and my is at most 212
        give back 1
    end
    if my is at least 222 and my is at most 258
        give back 2
    end
    if my is at least 268 and my is at most 304
        give back 3
    end
    give back -1
end

wallpaper()
gc_mark()
while yes
    frame_reset()
    poll()
    let mx be mouse_x()
    let my be mouse_y()
    let down be mouse_down()
    let k be key()
    if k is not ""
        change buf to buf + k
    end
    if down is 1 and prevdown is 0
        let handled be 0
        if mx is at least 18 and mx is at most 58
            let di be dock_hit(my)
            if di is at least 0
                let dw be windows[di]
                change dw at "open" to 1
                change front to di
                change handled to 1
            end
        end
        let i be 0
        for each w in windows
            if w["open"] is 1 and handled is 0
                if mx is at least (w["x"] + w["w"] - 28) and mx is at most (w["x"] + w["w"] - 6) and my is at least (w["y"] + 5) and my is at most (w["y"] + 25)
                    change w at "open" to 0
                    change handled to 1
                otherwise if mx is at least w["x"] and mx is at most (w["x"] + w["w"]) and my is at least w["y"] and my is at most (w["y"] + 30)
                    change drag to i
                    change dox to mx - w["x"]
                    change doy to my - w["y"]
                    change front to i
                    change handled to 1
                end
            end
            change i to i + 1
        end
    end
    if down is 1 and drag is at least 0
        let w be windows[drag]
        change w at "x" to mx - dox
        change w at "y" to my - doy
    end
    if down is 0
        change drag to -1
    end
    change prevdown to down

    clear()
    fill(0, 0, sw, 30, navy)
    text_big(16, 7, "V-NOx", accent)
    text_at(sw - 290, 11, "click dock to open  -  drag titles  -  X closes", dim)
    fill(12, 120, 52, 250, panelc)
    fill(20, 130, 36, 36, accent)
    fill(20, 176, 36, 36, green)
    fill(20, 222, 36, 36, rgb(168, 85, 247))
    fill(20, 268, 36, 36, rgb(245, 158, 11))
    fill(sw / 2 - 150, sh - 46, 300, 36, panelc)
    text_at(sw / 2 - 100, sh - 35, "V-NOx 1  -  Vanta, bare metal", dim)
    let i be 0
    for each w in windows
        if w["open"] is 1 and i is not front
            draw_window(w)
        end
        change i to i + 1
    end
    if windows[front]["open"] is 1
        draw_window(windows[front])
    end
    cursor(mx, my)
    present()
end
