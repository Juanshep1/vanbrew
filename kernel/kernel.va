say "================================================"
say "  V-NOx kernel  -  written in Vanta"
say "  running on bare metal: no OS, no Python."
say "================================================"
say ""
let total be 0
for each i in range(1, 101)
    change total to total + i
end
say "kernel computed sum 1..100 = " + text(total)
to fib(n)
    if n is under 2
        give back n
    end
    give back fib(n - 1) + fib(n - 2)
end
say "kernel computed fib(20) = " + text(fib(20))
let words be ["Vanta", "compiled", "itself", "to", "a", "kernel"]
say join(words, " ")
say "sorted demo: " + text(sort([5, 2, 8, 1, 9, 3]))
say ""
say "V-NOx kernel ready. (this is real machine code on the CPU)"
