to gen_expr(node)
    let k be node["k"]
    if k is "num"
        give back "NUM(" + text(node["v"]) + ")"
    end
    if k is "str"
        give back "STR(\"" + c_escape(node["v"]) + "\")"
    end
    if k is "lit"
        if node["v"] is yes
            give back "BOOLV(1)"
        end
        if node["v"] is no
            give back "BOOLV(0)"
        end
        give back "NIL()"
    end
    if k is "var"
        give back "v_" + node["name"]
    end
    if k is "neg"
        give back "NEG(" + gen_expr(node["a"]) + ")"
    end
    if k is "not"
        give back "NOTV(" + gen_expr(node["a"]) + ")"
    end
    if k is "and"
        give back "ANDV(" + gen_expr(node["a"]) + ", " + gen_expr(node["b"]) + ")"
    end
    if k is "or"
        give back "ORV(" + gen_expr(node["a"]) + ", " + gen_expr(node["b"]) + ")"
    end
    if k is "bin"
        give back bin_fn(node["op"]) + "(" + gen_expr(node["a"]) + ", " + gen_expr(node["b"]) + ")"
    end
    if k is "cmp"
        give back cmp_fn(node["op"]) + "(" + gen_expr(node["a"]) + ", " + gen_expr(node["b"]) + ")"
    end
    if k is "list"
        let parts be []
        for each it in node["items"]
            add gen_expr(it) to parts
        end
        give back "MKLIST(" + text(length(node["items"])) + join_pre(parts) + ")"
    end
    if k is "map"
        let parts be []
        for each pr in node["pairs"]
            add gen_expr(pr["kn"]) to parts
            add gen_expr(pr["vn"]) to parts
        end
        give back "MKMAP(" + text(length(node["pairs"])) + join_pre(parts) + ")"
    end
    if k is "index"
        give back "INDEX(" + gen_expr(node["o"]) + ", " + gen_expr(node["idx"]) + ")"
    end
    if k is "slice"
        give back "SLICE(" + gen_expr(node["o"]) + ", " + gen_expr(node["a"]) + ", " + gen_expr(node["b"]) + ")"
    end
    if k is "call"
        let name be node["name"]
        if name is "range"
            if length(node["args"]) is 1
                give back "B_range(" + gen_expr(node["args"][0]) + ", NUM(0), 0)"
            end
            give back "B_range(" + gen_expr(node["args"][0]) + ", " + gen_expr(node["args"][1]) + ", 1)"
        end
        if name is "serve"
            give back "vc_serve((long)(" + gen_expr(node["args"][0]) + ").n, v_" + node["args"][1]["name"] + ")"
        end
        if name is "path_join"
            let pj be []
            for each an in node["args"]
                add gen_expr(an) to pj
            end
            give back "B_path_join(" + text(length(node["args"])) + join_pre(pj) + ")"
        end
        if name is "http_get"
            if length(node["args"]) is 1
                give back "B_http_get(" + gen_expr(node["args"][0]) + ", NIL())"
            end
            give back "B_http_get(" + gen_expr(node["args"][0]) + ", " + gen_expr(node["args"][1]) + ")"
        end
        if name is "assert"
            if length(node["args"]) is 1
                give back "B_assert(" + gen_expr(node["args"][0]) + ", STR(\"\"))"
            end
            give back "B_assert(" + gen_expr(node["args"][0]) + ", " + gen_expr(node["args"][1]) + ")"
        end
        let bf be builtin_fn(name)
        let parts be []
        for each an in node["args"]
            add gen_expr(an) to parts
        end
        if bf is not ""
            give back bf + "(" + join(parts, ", ") + ")"
        end
        give back "v_" + name + "(" + join(parts, ", ") + ")"
    end
    give back "NIL()"
end

to join_pre(parts)
    let s be ""
    for each p in parts
        change s to s + ", " + p
    end
    give back s
end

to gen_block(stmts, ind)
    let out be ""
    for each st in stmts
        change out to out + gen_stmt(st, ind)
    end
    give back out
end

to gen_stmt(st, ind)
    let k be st["k"]
    if k is "let"
        give back ind + "Value v_" + st["name"] + " = " + gen_expr(st["e"]) + ";\n"
    end
    if k is "set"
        give back ind + "v_" + st["name"] + " = " + gen_expr(st["e"]) + ";\n"
    end
    if k is "setat"
        give back ind + "SETAT(v_" + st["name"] + ", " + gen_expr(st["key"]) + ", " + gen_expr(st["e"]) + ");\n"
    end
    if k is "add"
        give back ind + "listpush(" + gen_expr(st["target"]) + ", " + gen_expr(st["val"]) + ");\n"
    end
    if k is "say"
        give back ind + "SAY(" + gen_expr(st["e"]) + ");\n"
    end
    if k is "ret"
        give back ind + "return " + gen_expr(st["e"]) + ";\n"
    end
    if k is "expr"
        give back ind + gen_expr(st["e"]) + ";\n"
    end
    if k is "if"
        let s be ind + "if (truthy(" + gen_expr(st["c"]) + ")) {{\n" + gen_block(st["body"], ind + "    ") + ind + "}}"
        if length(st["els"]) is over 0
            change s to s + " else {{\n" + gen_block(st["els"], ind + "    ") + ind + "}}"
        end
        give back s + "\n"
    end
    if k is "while"
        give back ind + "while (truthy(" + gen_expr(st["c"]) + ")) {{\n" + gen_block(st["body"], ind + "    ") + ind + "}}\n"
    end
    if k is "for"
        change LOOPN to LOOPN + 1
        let id be text(LOOPN)
        let s be ind + "{{ Value _s" + id + " = " + gen_expr(st["list"]) + "; long _n" + id + " = (long)LEN(_s" + id + ").n;\n"
        change s to s + ind + "for (long _i" + id + " = 0; _i" + id + " < _n" + id + "; _i" + id + "++) {{\n"
        change s to s + ind + "    Value v_" + st["var"] + " = INDEX(_s" + id + ", NUM(_i" + id + "));\n"
        change s to s + gen_block(st["body"], ind + "    ")
        change s to s + ind + "}} }}\n"
        give back s
    end
    if k is "repeat"
        change LOOPN to LOOPN + 1
        let id be text(LOOPN)
        let s be ind + "{{ long _r" + id + " = (long)(" + gen_expr(st["n"]) + ").n;\n"
        change s to s + ind + "for (long _c" + id + " = 0; _c" + id + " < _r" + id + "; _c" + id + "++) {{\n"
        change s to s + gen_block(st["body"], ind + "    ")
        change s to s + ind + "}} }}\n"
        give back s
    end
    if k is "attempt"
        let s be ind + "{{ int _sp = g_jmpsp; if (setjmp(g_jmp[g_jmpsp++]) == 0) {{\n"
        change s to s + gen_block(st["body"], ind + "    ")
        change s to s + ind + "    g_jmpsp = _sp;\n" + ind + "}} else {{\n"
        change s to s + ind + "    g_jmpsp = _sp; Value v_" + st["errname"] + " = g_err;\n"
        change s to s + gen_block(st["rescue"], ind + "    ")
        change s to s + ind + "}} }}\n"
        give back s
    end
    give back ""
end

to params_proto(params)
    if length(params) is 0
        give back "void"
    end
    let p be []
    for each x in params
        add "Value" to p
    end
    give back join(p, ", ")
end

to params_decl(params)
    if length(params) is 0
        give back "void"
    end
    let p be []
    for each x in params
        add "Value v_" + x to p
    end
    give back join(p, ", ")
end

to compile_prog(src)
    let prog be []
    for each line in split(src, "\n")
        let toks be lex_line(line)
        if length(toks) is over 0
            add toks to prog
        end
    end
    let block be parse_block(prog, 0)
    let funcs be []
    let top be []
    for each st in block["stmts"]
        if st["k"] is "func"
            add st to funcs
        otherwise
            add st to top
        end
    end
    let c be base64_decode(RUNTIME_B64) + "\n"
    # top-level lets become C globals (so functions can see them); they are
    # assigned at the start of main, before any function is called.
    let mainstmts be []
    for each st in top
        if st["k"] is "let"
            change c to c + "Value v_" + st["name"] + ";\n"
            add {"k": "set", "name": st["name"], "e": st["e"]} to mainstmts
        otherwise
            add st to mainstmts
        end
    end
    change c to c + "\n"
    for each f in funcs
        change c to c + "Value v_" + f["name"] + "(" + params_proto(f["params"]) + ");\n"
    end
    change c to c + "\n"
    for each f in funcs
        change c to c + "Value v_" + f["name"] + "(" + params_decl(f["params"]) + ") {{\n"
        change c to c + gen_block(f["body"], "    ")
        change c to c + "    return NIL();\n}}\n\n"
    end
    change c to c + "int main(int argc, char** argv) {{\n    g_argc = argc; g_argv = argv;\n" + gen_block(mainstmts, "    ") + "    return 0;\n}}\n"
    give back c
end

# kernel/freestanding mode: emit just the program functions + a kmain(), with NO
# libc runtime (the bare-metal kernel runtime provides Value/SAY/galloc/etc.).
to compile_kernel(src)
    let prog be []
    for each line in split(src, "\n")
        let toks be lex_line(line)
        if length(toks) is over 0
            add toks to prog
        end
    end
    let block be parse_block(prog, 0)
    let funcs be []
    let top be []
    for each st in block["stmts"]
        if st["k"] is "func"
            add st to funcs
        otherwise
            add st to top
        end
    end
    let c be ""
    let mainstmts be []
    for each st in top
        if st["k"] is "let"
            change c to c + "Value v_" + st["name"] + ";\n"
            add {"k": "set", "name": st["name"], "e": st["e"]} to mainstmts
        otherwise
            add st to mainstmts
        end
    end
    change c to c + "\n"
    for each f in funcs
        change c to c + "Value v_" + f["name"] + "(" + params_proto(f["params"]) + ");\n"
    end
    change c to c + "\n"
    for each f in funcs
        change c to c + "Value v_" + f["name"] + "(" + params_decl(f["params"]) + ") {{\n"
        change c to c + gen_block(f["body"], "    ")
        change c to c + "    return NIL();\n}}\n\n"
    end
    change c to c + "void kmain(void) {{\n" + gen_block(mainstmts, "    ") + "}}\n"
    give back c
end

to build_and_run(src, base)
    let c be compile_prog(src)
    let cfile be base + ".c"
    write_file(cfile, c)
    let exe be base + ".bin"
    let r be shell("cc -O2 -w " + cfile + " -o " + exe)
    if r["code"] is not 0
        say "C compile error:"
        say r["output"]
        give back nothing
    end
    say "compiled -> " + exe + " (a native binary, no Python)"
    say "----"
    let runcmd be exe
    if starts_with(exe, "/") is no
        change runcmd to "./" + exe
    end
    say run(runcmd)
end

to compile_only(src, base)
    let c be compile_prog(src)
    write_file(base + ".c", c)
    let r be shell("cc -O2 -w " + base + ".c -o " + base + ".bin")
    if r["code"] is not 0
        say "C compile error:"
        say r["output"]
        give back nothing
    end
    say "compiled -> " + base + ".bin"
end

# ====== driver =============================================================
let args be arguments()
if length(args) is over 1 and args[1] is "-k"
    write_file(args[0] + ".c", compile_kernel(read_file(args[0])))
    say "emitted freestanding kernel C -> " + args[0] + ".c"
otherwise if length(args) is over 1 and args[1] is "-c"
    compile_only(read_file(args[0]), args[0])
otherwise if length(args) is over 0
    build_and_run(read_file(args[0]), args[0])
otherwise
    say "vc - compiling a Vanta program (strings, lists, maps) to a NATIVE binary:"
    let demo be "to fib(n)\n    if n is under 2\n        give back n\n    end\n    give back fib(n - 1) + fib(n - 2)\nend\nsay \"fib(20) = \" + text(fib(20))\nlet nums be [4, 1, 3, 1, 5, 9, 2, 6]\nlet total be 0\nfor each n in nums\n    change total to total + n\nend\nsay \"sum \" + text(nums) + \" = \" + text(total)\nsay \"sorted = \" + text(sort(nums))\nlet who be {{\"name\": \"Ada\", \"lang\": \"Vanta\"}}\nsay who[\"name\"] + \" writes \" + who[\"lang\"]\nlet shout be \"\"\nfor each w in [\"compiled\", \"to\", \"native\"]\n    change shout to shout + uppercase(w) + \" \"\nend\nsay trim(shout)\n"
    build_and_run(demo, "/tmp/vcdemo2")
end
