to nav()
    let n be "<nav><a class='brand' href='/'>TOPDECK</a>"
    change n to n + "<a href='/'>Meta</a>"
    change n to n + "<a href='/decks'>Top Decks</a>"
    change n to n + "<a href='/analyze'>Analyze</a>"
    change n to n + "<a href='/counters'>Counters</a>"
    change n to n + "<a href='/build'>Builder</a>"
    change n to n + "<a href='/deckbuild'>Auto-Build</a>"
    change n to n + "<a href='/ai'>AI</a>"
    change n to n + "<a href='/settings'>Settings</a></nav>"
    give back n
end

# Click-to-read card lightbox: any element with data-id opens it.
to modal_html()
    let h be "<div id='cardmodal' class='cmodal'><div class='cmbox'><span id='cmx' class='cmx'>&times;</span><img id='cmimg' class='cmimg' alt=''><div class='cminfo'><h3 id='cmname'></h3><div id='cmmeta' class='cmmeta'></div><p id='cmdesc' class='cmdesc'></p></div></div></div>"
    change h to h + "<script>"
    change h to h + "(function(){{"
    change h to h + "var m=document.getElementById('cardmodal');"
    change h to h + "function cl(){{m.className='cmodal';}}"
    change h to h + "function op(id,nm){{"
    change h to h + "document.getElementById('cmimg').src='https://images.ygoprodeck.com/images/cards/'+id+'.jpg';"
    change h to h + "document.getElementById('cmname').textContent=nm||'';"
    change h to h + "document.getElementById('cmmeta').textContent='';"
    change h to h + "document.getElementById('cmdesc').textContent='Loading card text...';"
    change h to h + "m.className='cmodal open';"
    change h to h + "fetch('/api/card?id='+id).then(function(r){{return r.json();}}).then(function(d){{"
    change h to h + "if(d.name){{document.getElementById('cmname').textContent=d.name;}}"
    change h to h + "document.getElementById('cmmeta').textContent=d.meta||'';"
    change h to h + "document.getElementById('cmdesc').textContent=d.desc||'No card text available.';"
    change h to h + "}}).catch(function(){{document.getElementById('cmdesc').textContent='Could not load card text.';}});"
    change h to h + "}}"
    change h to h + "document.addEventListener('click',function(e){{"
    change h to h + "var c=e.target.closest('[data-id]');"
    change h to h + "if(c){{op(c.getAttribute('data-id'),c.getAttribute('data-name'));return;}}"
    change h to h + "if(e.target===m||e.target.id==='cmx'){{cl();}}"
    change h to h + "}});"
    change h to h + "document.addEventListener('keydown',function(e){{if(e.key==='Escape'){{cl();}}}});"
    change h to h + "}})();"
    change h to h + "</script>"
    give back h
end

to page(title, body)
    let h be "<!doctype html><html><head><meta charset='utf-8'>"
    change h to h + "<meta name='viewport' content='width=device-width,initial-scale=1'>"
    change h to h + "<title>" + title + " - Topdeck</title><style>" + styles() + "</style></head><body>"
    change h to h + nav() + "<main>" + body + "</main>"
    change h to h + "<footer>Topdeck - a Master Duel meta analyzer, written in Vanta. Meta data via masterduelmeta.com (unofficial).</footer>"
    change h to h + modal_html() + "</body></html>"
    give back h
end

to source_badge()
    if meta_source is "live"
        give back "<span class='badge live'>LIVE DATA</span>"
    end
    give back "<span class='badge snap'>SNAPSHOT (API unavailable)</span>"
end

# ---- pages -----------------------------------------------------------
to meta_body()
    let meta be fetch_meta()
    let top be meta["top"]
    let decks be meta["decks"]
    let shown be top[0:18]
    # derive a face card for each archetype, then one image lookup for all
    let faces be {}
    let names be []
    for each row in shown
        let arche be row["name"]
        let fn be face_name(arche, decks)
        if fn is not nothing
            let fk be arche
            change faces at fk to fn
            add fn to names
        end
    end
    let ids be card_ids(names)
    let maxc be 1
    if length(shown) is over 0
        change maxc to shown[0]["count"]
    end
    let b be "<div class='hero'><h1>The Current Meta " + source_badge() + "</h1>"
    change b to b + "<p class='lede'>What the community is playing right now - ranked by how often each archetype shows up in the latest submitted decks.</p></div>"
    change b to b + "<div class='grid-cards'>"
    let i be 0
    for each row in shown
        change i to i + 1
        let arche be row["name"]
        let ct be row["count"]
        let w be floor(ct * 100 / maxc)
        let art be ""
        if arche is in faces
            let fn be faces[arche]
            if fn is in ids
                let cid be ids[fn]
                change art to "<div class='mc-art'><img loading='lazy' src='https://images.ygoprodeck.com/images/cards_small/" + text(cid) + ".jpg' alt=''></div>"
            end
        end
        let tlabel be "?"
        let tcls be "tC"
        let counter be ""
        if arche is in kb
            change tlabel to kb[arche]["tier"]
            change tcls to tier_class(tlabel)
            let wt be kb[arche]["weak_to"]
            if length(wt) is over 0
                change counter to "<div class='mc-counter'>weak to " + html_escape(trim(wt[0])) + "</div>"
            end
        end
        change b to b + "<a class='metacard' href='/analyze?deck=" + url_encode(arche) + "'>" + art
        change b to b + "<div class='mc-info'><div class='mc-head'><span class='rank'>#" + text(i) + "</span><span class='tier " + tcls + "'>" + tlabel + "</span></div>"
        change b to b + "<div class='mc-name'>" + html_escape(arche) + "</div>"
        change b to b + "<div class='mc-bar-bg'><div class='mc-bar' style='width:" + text(w) + "%'></div></div>"
        change b to b + "<div class='mc-note'>" + text(ct) + " recent decks</div>" + counter + "</div></a>"
    end
    change b to b + "</div>"
    change b to b + "<p class='note'>Tap any deck for its full breakdown. See <a href='/counters'>Counters</a> for the cards that beat the most of this list, or the <a href='/build'>Builder</a> to analyze your own.</p>"
    give back b
end

# YGOPRODeck name -> card id, cached across requests so browsing stays fast.
let id_cache be {}

# ---- full card index: one bulk fetch -> local, precise name matching --------
let card_index be {}
let tok_index be {}
let id_norm be {}
let index_loaded be no

# lowercase + strip every non-alphanumeric char to single spaces (so punctuation,
# quotes, colons and commas can't cause a miss). "Maxx \"C\"" -> "maxx c".
to normalize(s)
    let low be lowercase(s)
    let out be ""
    let prevspace be yes
    let i be 0
    while i is under length(low)
        let ch be low[i]
        if ch is in "abcdefghijklmnopqrstuvwxyz0123456789"
            change out to out + ch
            change prevspace to no
        otherwise
            if not prevspace
                change out to out + " "
                change prevspace to yes
            end
        end
        change i to i + 1
    end
    give back trim(out)
end

# load the entire YGOPRODeck card list once; build normalized name->id, a word
# index (words len>=5), and id->normalized-name. Cached for the server's life.
to load_card_index()
    if index_loaded
        give back nothing
    end
    change index_loaded to yes
    attempt
        let r be http_get("https://db.ygoprodeck.com/api/v7/cardinfo.php", {"User-Agent": UA})
        if r["status"] is 200
            let data be from_json(r["body"])["data"]
            for each c in data
                let id be c["id"]
                let norm be normalize(c["name"])
                change card_index at norm to id
                let ik be id
                change id_norm at ik to norm
                for each w in split(norm, " ")
                    if length(w) is at least 5
                        if w is in tok_index
                            add id to tok_index[w]
                        otherwise
                            let wk be w
                            change tok_index at wk to [id]
                        end
                    end
                end
            end
        end
    rescue e
        change index_loaded to yes
    end
end

# the up-to-2 longest distinctive words (len>=5) of a normalized name
to longest_words(words)
    let a be ""
    let b be ""
    for each w in words
        if length(w) is at least 5
            if length(w) is over length(a)
                change b to a
                change a to w
            otherwise
                if length(w) is over length(b)
                    change b to w
                end
            end
        end
    end
    let out be []
    if a is not ""
        add a to out
    end
    if b is not ""
        add b to out
    end
    give back out
end

# how many distinctive (len>=4) query words appear in a candidate's words
to overlap(qwords, cnorm)
    let cw be split(cnorm, " ")
    let sc be 0
    for each q in qwords
        if length(q) is at least 4
            for each c in cw
                if c is q
                    change sc to sc + 1
                end
            end
        end
    end
    give back sc
end

# does the candidate contain EVERY query word (len>=3)? - catches shorthand like
# "Ash Blossom" inside "Ash Blossom & Joyous Spring".
to contains_all(qwords, cnorm)
    let cw be split(cnorm, " ")
    for each q in qwords
        if length(q) is at least 3
            let found be no
            for each c in cw
                if c is q
                    change found to yes
                end
            end
            if not found
                give back no
            end
        end
    end
    give back yes
end

# name -> id using the local index: exact-normalized, then a bounded token-overlap
# match for near-misses (e.g. an AI typo). 0 when nothing matches well.
to resolve_name(name)
    load_card_index()
    if length(card_index) is 0
        give back fuzzy_one(name)
    end
    let norm be normalize(name)
    if norm is in card_index
        give back card_index[norm]
    end
    let qwords be split(norm, " ")
    let candidates be []
    for each w in longest_words(qwords)
        if w is in tok_index
            let lst be tok_index[w]
            if length(lst) is at most 150
                for each id in lst
                    add id to candidates
                end
            end
        end
    end
    let best be 0
    let bestrank be 0
    for each id in candidates
        let ik be id
        let cnorm be id_norm[ik]
        let ov be overlap(qwords, cnorm)
        let sub be 0
        if contains_all(qwords, cnorm)
            change sub to 1
        end
        let ok be no
        if ov is at least 2
            change ok to yes
        end
        if sub is 1 and length(qwords) is at least 2
            change ok to yes
        end
        let rank be ov + sub * 2
        if ok and rank is over bestrank
            change bestrank to rank
            change best to id
        end
    end
    give back best
end

# Fuzzy name search - finds the closest real card when the exact name misses.
to fuzzy_one(query)
    attempt
        let url be "https://db.ygoprodeck.com/api/v7/cardinfo.php?fname=" + url_encode(query)
        let r be http_get(url, {"User-Agent": UA})
        if r["status"] is 200
            let data be from_json(r["body"])["data"]
            if length(data) is over 0
                let best be data[0]["id"]
                let want be lowercase(query)
                for each c in data
                    if lowercase(c["name"]) is want
                        change best to c["id"]
                    end
                end
                give back best
            end
        end
    rescue e
        give back 0
    end
    give back 0
end

to fuzzy_id(name)
    let id be fuzzy_one(name)
    if id is not 0
        give back id
    end
    let words be split(name, " ")
    if length(words) is over 2
        change id to fuzzy_one(join(words[0:length(words) - 1], " "))
    end
    give back id
end

to card_ids(names)
    load_card_index()
    for each n in names
        if not (n is in id_cache)
            let nk be n
            change id_cache at nk to resolve_name(n)
        end
    end
    let out be {}
    for each n in names
        if n is in id_cache and id_cache[n] is not 0
            let ok be n
            change out at ok to id_cache[n]
        end
    end
    give back out
end

# Full card detail (name, rules text, stat line) by id - cached.
let card_meta be {}
to fetch_card(cid)
    let k be text(cid)
    if k is in card_meta
        give back card_meta[k]
    end
    let nm be ""
    let ds be ""
    let mt be ""
    attempt
        let url be "https://db.ygoprodeck.com/api/v7/cardinfo.php?id=" + k
        let r be http_get(url, {"User-Agent": UA})
        if r["status"] is 200
            let c be from_json(r["body"])["data"][0]
            change nm to c["name"]
            change ds to c["desc"]
            change mt to c["type"]
            if "race" is in c
                change mt to mt + " - " + c["race"]
            end
            if "atk" is in c
                change mt to mt + "   ATK " + text(c["atk"]) + " / DEF " + text(c["def"])
            end
        end
    rescue e
        change ds to ds
    end
    let val be {"name": nm, "desc": ds, "meta": mt}
    change card_meta at k to val
    give back val
end

to tier_class(t)
    if t is "S"
        give back "tS"
    end
    if t is "A"
        give back "tA"
    end
    if t is "B"
        give back "tB"
    end
    give back "tC"
end

# pick a representative card name for an archetype, from the live decks
to face_name(arche, decks)
    for each d in decks
        let dt be d["deckType"]
        if dt is not nothing and dt["name"] is arche
            for each c in d["main"]
                let cm be c["card"]
                if lowercase(arche) is in lowercase(cm["name"])
                    give back cm["name"]
                end
            end
            if length(d["extra"]) is over 0
                let ex be d["extra"][0]
                let exc be ex["card"]
                give back exc["name"]
            end
            if length(d["main"]) is over 0
                let fm be d["main"][0]
                let fmc be fm["card"]
                give back fmc["name"]
            end
            give back nothing
        end
    end
    give back nothing
end

# Render a list of card NAMES as art where they resolve, text pills otherwise.
# `notes` (optional map name->label) adds a small line under a card.
to card_chips(names, notes)
    let clean be []
    for each n in names
        add trim(n) to clean
    end
    let ids be card_ids(clean)
    let h be "<div class='chips'>"
    for each n in clean
        let extra be ""
        if notes is not nothing and n is in notes
            change extra to "<span class='ans'>" + html_escape(notes[n]) + "</span>"
        end
        if n is in ids
            let cid be ids[n]
            change h to h + "<div class='cardchip' data-id='" + text(cid) + "' data-name='" + html_escape(n) + "' title='click to read'><img loading='lazy' src='https://images.ygoprodeck.com/images/cards_small/" + text(cid) + ".jpg' alt='" + html_escape(n) + "'><span class='cn'>" + html_escape(n) + "</span>" + extra + "</div>"
        otherwise
            change h to h + "<div class='cardchip'>" + card_back_tile(n, nothing, 88) + extra + "</div>"
        end
    end
    change h to h + "</div>"
    give back h
end

to deck_cards_html(cards, label, ids)
    let h be "<h2>" + label + "</h2><div class='cards'>"
    for each c in cards
        let card be c["card"]
        let amt be c["amount"]
        let nm be card["name"]
        if nm is in ids
            change h to h + card_tile(ids[nm], nm, amt)
        otherwise
            change h to h + card_tile(0, nm, amt)
        end
    end
    change h to h + "</div>"
    give back h
end

to decks_body(q)
    let meta be fetch_meta()
    let decks be meta["decks"]
    if length(decks) is 0
        give back "<h1>Top Decks " + source_badge() + "</h1><p class='lede'>Live deck lists are unavailable right now (API offline) - the meta page still works from the snapshot.</p>"
    end
    if "deck" is in q
        let idx be number(q["deck"])
        if idx is at least 0 and idx is under length(decks)
            let d be decks[idx]
            let dt be d["deckType"]
            let rt be d["rankedType"]
            let b be "<h1>" + html_escape(dt["name"]) + "</h1>"
            change b to b + "<p class='lede'>" + html_escape(rt["name"]) + " &middot; <a href='/analyze?deck=" + url_encode(dt["name"]) + "'>see analysis</a></p>"
            let names be []
            for each c in d["main"]
                let cm be c["card"]
                add cm["name"] to names
            end
            for each c in d["extra"]
                let cx be c["card"]
                add cx["name"] to names
            end
            let ids be card_ids(names)
            change b to b + deck_cards_html(d["main"], "Main Deck", ids)
            change b to b + deck_cards_html(d["extra"], "Extra Deck", ids)
            give back b
        end
    end
    # a face card per deck, one lookup for all of them
    let shown be decks[0:30]
    let faces be []
    let names be []
    for each d in shown
        let fn be nothing
        if length(d["extra"]) is over 0
            let e0 be d["extra"][0]
            let e0c be e0["card"]
            change fn to e0c["name"]
        otherwise if length(d["main"]) is over 0
            let m0 be d["main"][0]
            let m0c be m0["card"]
            change fn to m0c["name"]
        end
        add fn to faces
        if fn is not nothing
            add fn to names
        end
    end
    let ids be card_ids(names)
    let b be "<div class='hero'><h1>Top Decks " + source_badge() + "</h1><p class='lede'>Recent community deck submissions. Tap one for the full list with card art.</p></div>"
    change b to b + "<div class='grid-cards'>"
    let i be 0
    for each d in shown
        let dt be d["deckType"]
        let rt be d["rankedType"]
        let art be ""
        let fn be faces[i]
        if fn is not nothing and fn is in ids
            let cid be ids[fn]
            change art to "<div class='mc-art'><img loading='lazy' src='https://images.ygoprodeck.com/images/cards_small/" + text(cid) + ".jpg' alt=''></div>"
        end
        change b to b + "<a class='metacard' href='/decks?deck=" + text(i) + "'>" + art
        change b to b + "<div class='mc-info'><div class='mc-name'>" + html_escape(dt["name"]) + "</div>"
        change b to b + "<div class='mc-note'>" + html_escape(rt["name"]) + "</div></div></a>"
        change i to i + 1
    end
    change b to b + "</div>"
    give back b
end

to analyze_body(q)
    let meta be fetch_meta()
    let b be "<h1>Analyze a Deck</h1>"
    change b to b + "<form method='get' action='/analyze'><select name='deck'>"
    for each nm in kb_names
        change b to b + "<option value='" + html_escape(nm) + "'>" + html_escape(nm) + "</option>"
    end
    change b to b + "</select><button>Analyze</button></form>"
    if "deck" is in q
        let name be q["deck"]
        let a be analyze(name)
        if a is nothing
            change b to b + "<div class='card'><h2 style='margin-top:0'>" + html_escape(name) + "</h2>"
            change b to b + "<p>No curated analysis for this archetype yet - it may be new to the meta. Try <a href='/ai'>AI analysis</a> for a live breakdown.</p></div>"
            give back b
        end
        let tcls be tier_class(a["tier"])
        let face be face_name(name, meta["decks"])
        let fart be ""
        if face is not nothing
            let fids be card_ids([face])
            if face is in fids
                change fart to "<div class='mc-art' style='width:78px'><img src='https://images.ygoprodeck.com/images/cards_small/" + text(fids[face]) + ".jpg' alt=''></div>"
            end
        end
        change b to b + "<div class='card'><div class='metacard' style='border:0;padding:0;margin-bottom:6px'>" + fart
        change b to b + "<div class='mc-info'><span class='tier " + tcls + "'>Tier " + a["tier"] + "</span><div class='mc-name' style='font-size:22px'>" + html_escape(name) + "</div></div></div>"
        change b to b + "<p>" + html_escape(a["summary"]) + "</p>"
        change b to b + "<h2>Weak to</h2>" + card_chips(a["weak_to"], nothing)
        change b to b + "<h2>Tech cards</h2>" + card_chips(a["tech"], nothing)
        change b to b + "<h2>Gameplan</h2><p>" + html_escape(a["gameplan"]) + "</p>"
        # cross-reference: which counter decks are actually being played now?
        change b to b + "<h2>Counter decks in today's meta</h2><div>"
        let found be no
        for each row in meta["top"]
            let other be row["name"]
            if other is in kb
                for each beat in kb[other]["beats"]
                    if trim(beat) is name
                        change b to b + "<span class='pill tech'>" + html_escape(other) + "</span>"
                        change found to yes
                    end
                end
            end
        end
        if not found
            change b to b + "<span class='note'>No hard counter archetype trending - rely on the tech cards above.</span>"
        end
        change b to b + "</div></div>"
    end
    give back b
end

to counters_body(q)
    let meta be fetch_meta()
    let b be "<h1>Counter the Meta " + source_badge() + "</h1>"
    let cm be counter_the_meta(meta["top"])
    change b to b + "<p class='lede'>The cards that answer the most of today's top decks (" + text(cm["covered"]) + " covered by the knowledge base).</p>"
    let cnames be []
    let cnotes be {}
    for each c in cm["cards"][0:14]
        let cn be c["card"]
        add cn to cnames
        let nk be cn
        change cnotes at nk to "answers " + text(c["answers"])
    end
    change b to b + card_chips(cnames, cnotes)
    change b to b + "<h2>Counter a specific deck</h2>"
    change b to b + "<form method='get' action='/counters'><select name='vs'>"
    for each nm in kb_names
        change b to b + "<option value='" + html_escape(nm) + "'>" + html_escape(nm) + "</option>"
    end
    change b to b + "</select><button>Show counters</button></form>"
    if "vs" is in q
        let name be q["vs"]
        let a be analyze(name)
        if a is not nothing
            change b to b + "<div class='card'><h2 style='margin-top:0'>How to beat " + html_escape(name) + "</h2>"
            change b to b + card_chips(a["weak_to"], nothing)
            change b to b + "<p class='note'>Side these in, and play around the gameplan: " + html_escape(a["gameplan"]) + "</p></div>"
        end
    end
    give back b
end

to detect_archetype(text)
    let low be lowercase(text)
    for each nm in kb_names
        if lowercase(nm) is in low
            give back nm
        end
    end
    give back nothing
end

to build_body(q)
    let b be "<h1>Deck Builder & Analyzer</h1>"
    change b to b + "<p class='lede'>Paste a decklist (card names) or pick an archetype - get its weaknesses, a gameplan, and the tech cards worth running against today's meta.</p>"
    change b to b + "<form method='get' action='/build'>"
    change b to b + "<textarea name='list' placeholder='paste a decklist - card names, one per line...'>"
    if "list" is in q
        change b to b + html_escape(q["list"])
    end
    change b to b + "</textarea>"
    change b to b + "<select name='deck'><option value=''>- or pick an archetype -</option>"
    for each nm in kb_names
        change b to b + "<option value='" + html_escape(nm) + "'>" + html_escape(nm) + "</option>"
    end
    change b to b + "</select><button>Analyze my deck</button></form>"
    let arche be nothing
    if "deck" is in q and length(q["deck"]) is over 0
        change arche to q["deck"]
    otherwise if "list" is in q and length(trim(q["list"])) is over 0
        change arche to detect_archetype(q["list"])
    end
    if arche is nothing and ("list" is in q or "deck" is in q)
        change b to b + "<div class='card'><p>Couldn't recognise the archetype from that list. Pick one from the dropdown, or try <a href='/ai'>AI analysis</a> which reads any list.</p></div>"
        give back b
    end
    if arche is not nothing
        let a be analyze(arche)
        if a is nothing
            change b to b + "<div class='card'><p>No curated analysis for " + html_escape(arche) + " yet - try <a href='/ai'>AI analysis</a>.</p></div>"
            give back b
        end
        change b to b + "<div class='card'><div class='row'><span class='tier'>" + a["tier"] + "</span><h2 style='margin:0;border:0'>" + html_escape(arche) + "</h2></div>"
        change b to b + "<p>" + html_escape(a["summary"]) + "</p>"
        change b to b + "<h2>What beats you</h2>" + card_chips(a["weak_to"], nothing)
        change b to b + "<h2>Your gameplan</h2><p>" + html_escape(a["gameplan"]) + "</p>"
        let meta be fetch_meta()
        let cm be counter_the_meta(meta["top"])
        let tnames be []
        for each c in cm["cards"][0:8]
            add c["card"] to tnames
        end
        change b to b + "<h2>Tech worth running vs today's meta</h2><p class='note'>Cards that answer the most of the decks you'll face right now.</p>"
        change b to b + card_chips(tnames, nothing) + "</div>"
    end
    give back b
end

to ai_body(q)
    let b be "<h1>AI Analysis</h1>"
    if ai["key"] is ""
        change b to b + "<p class='lede'>Bring your own API key (set it in <a href='/settings'>Settings</a>) and ask anything - paste a decklist, ask what to tech, or how to beat the current meta. The current live meta is fed to the AI automatically.</p>"
    otherwise
        change b to b + "<p class='lede'>Ask anything - paste a decklist, ask what to side, or how to beat a deck. The live meta is included as context.</p>"
    end
    let cur be ""
    if "q" is in q
        change cur to q["q"]
    end
    change b to b + "<form method='get' action='/ai'><textarea name='q' placeholder='e.g. I play Snake-Eye - what should I tech against the current meta?'>" + html_escape(cur) + "</textarea><button>Ask</button></form>"
    if "q" is in q and length(trim(cur)) is over 0
        let answer be ai_analyze(cur)
        change b to b + "<div class='card'><p style='white-space:pre-wrap'>" + html_escape(answer) + "</p></div>"
    end
    give back b
end

to settings_body(q)
    # provider/model update freely; the KEY only updates when a non-empty value is
    # actually submitted (so changing the model, or a blank browser autofill, can
    # never wipe or clobber a saved key). The key is trimmed of stray whitespace.
    if "provider" is in q
        let pp be "provider"
        change ai at pp to q["provider"]
    end
    if "model" is in q
        let mp be "model"
        change ai at mp to q["model"]
    end
    if "key" is in q and length(trim(q["key"])) is over 0
        let kp be "key"
        change ai at kp to trim(q["key"])
    end
    let b be "<h1>AI Settings</h1><p class='lede'>Optional. Your key is kept in memory on this local server only.</p>"
    change b to b + "<form method='get' action='/settings' autocomplete='off'>"
    change b to b + "<select name='provider'>"
    for each p in ["openrouter", "anthropic", "ollama-cloud", "nvidia"]
        let sel be ""
        if p is ai["provider"]
            change sel to " selected"
        end
        change b to b + "<option value='" + p + "'" + sel + ">" + p + "</option>"
    end
    change b to b + "</select>"
    # Model field: a live picker populated from the current provider's model list.
    let models be provider_models()
    if length(models) is over 0
        let cur be ai["model"]
        let inlist be no
        for each m in models
            if m is cur
                change inlist to yes
            end
        end
        # if the saved model isn't valid for this provider, default to a known-good
        # model (first curated pick that's actually offered), else the first listed.
        let target be cur
        if not inlist
            change target to models[0]
            let picked be no
            for each pref in curated_models(ai["provider"])
                if not picked
                    let found be no
                    for each m in models
                        if m is pref
                            change found to yes
                        end
                    end
                    if found
                        change target to pref
                        change picked to yes
                    end
                end
            end
        end
        change b to b + "<select name='model'>"
        for each m in models
            let sel be ""
            if m is target
                change sel to " selected"
            end
            change b to b + "<option value='" + html_escape(m) + "'" + sel + ">" + html_escape(m) + "</option>"
        end
        if not inlist
            change b to b + "<option value='" + html_escape(cur) + "'>" + html_escape(cur) + " (keep current)</option>"
        end
        change b to b + "</select>"
        change b to b + "<p class='note'>" + text(length(models)) + " " + ai["provider"] + " models available.</p>"
    otherwise
        change b to b + "<input name='model' value='" + html_escape(ai["model"]) + "' placeholder='model'>"
    end
    change b to b + "<button>Save provider &amp; model</button></form>"
    # Separate POST form for the key, so changing the model never resubmits (and a
    # password-manager autofill can't overwrite) your real key, and the secret
    # never lands in the URL/history.
    change b to b + "<form method='post' action='/settings' autocomplete='off'>"
    let kph be "paste API key"
    if ai["key"] is not ""
        change kph to "paste a new key (blank = keep current)"
    end
    change b to b + "<input name='key' type='password' autocomplete='new-password' value='' placeholder='" + kph + "' style='min-width:280px'>"
    change b to b + "<button>Save key</button></form>"
    if ai["key"] is ""
        change b to b + "<p class='note'>No key set yet. Provider: " + ai["provider"] + ", model: " + html_escape(ai["model"]) + ".</p>"
    otherwise
        change b to b + "<p class='note'>A key is set (" + text(length(ai["key"])) + " chars). Provider: " + ai["provider"] + ", model: " + html_escape(ai["model"]) + ".</p>"
        change b to b + "<form method='get' action='/settings'><input type='hidden' name='test' value='1'><button>Test connection</button></form>"
    end
    if "test" is in q
        let res be ai_ping()
        let cls be "snap"
        if "Connected" is in res
            change cls to "live"
        end
        change b to b + "<p class='note'><span class='badge " + cls + "'>" + html_escape(res) + "</span></p>"
    end
    # provider-specific guidance + a quick format sanity check on the saved key
    let hint be "Get your key from your provider's dashboard and paste the WHOLE thing."
    if ai["provider"] is "openrouter"
        change hint to "OpenRouter keys come from <b>openrouter.ai/keys</b> and look like <code>sk-or-v1-...</code> (about 73 chars)."
        if ai["key"] is not "" and not (starts_with(ai["key"], "sk-or-v1-"))
            change hint to hint + " <span style='color:#e7b25a'>Your saved key does not start with sk-or-v1- - it's likely the wrong key or truncated.</span>"
        end
    end
    if ai["provider"] is "ollama-cloud"
        change hint to "Ollama Cloud keys come from <b>ollama.com/settings/keys</b> (your account must have Cloud access)."
    end
    if ai["provider"] is "anthropic"
        change hint to "Anthropic keys come from <b>console.anthropic.com</b> and look like <code>sk-ant-...</code>."
    end
    change b to b + "<p class='note'>" + hint + "</p>"
    give back b
end

to deckbuild_body(q)
    let b be "<h1>Auto-Build a Deck</h1>"
    if ai["key"] is ""
        change b to b + "<p class='lede'>Describe a deck and the AI builds a full, craftable list - or brews an original deck nobody's playing. Needs an API key (set it in <a href='/settings'>Settings</a>).</p>"
    otherwise
        change b to b + "<p class='lede'>Describe a deck (archetype, strategy, budget) and the AI builds a complete decklist you can craft in-game - or hit <b>Brew something unique</b> for an original rogue deck. Card art is pulled in so you can spot each card in Duel Links / Master Duel.</p>"
    end
    let idea be ""
    if "idea" is in q
        change idea to q["idea"]
    end
    let game be "Master Duel"
    if "game" is in q
        change game to q["game"]
    end
    change b to b + "<form method='get' action='/deckbuild' class='dbform'>"
    change b to b + "<input name='idea' value='" + html_escape(idea) + "' placeholder='e.g. budget Snake-Eye, or a Dragon control deck'>"
    let mdsel be ""
    let dlsel be ""
    if game is "Duel Links"
        change dlsel to " selected"
    otherwise
        change mdsel to " selected"
    end
    change b to b + "<select name='game'><option value='Master Duel'" + mdsel + ">Master Duel</option><option value='Duel Links'" + dlsel + ">Duel Links</option></select>"
    change b to b + "<button name='mode' value='build'>Build it</button>"
    change b to b + "<button name='mode' value='brew' class='alt'>Brew something unique</button>"
    change b to b + "</form>"
    if ai["key"] is not "" and not ("mode" is in q)
        change b to b + "<p class='note'>Building calls your AI and can take 15-30 seconds - the page pauses while it works, that's normal.</p>"
    end
    if "mode" is in q
        if ai["key"] is ""
            change b to b + "<div class='card'><p>Set an API key in <a href='/settings'>Settings</a> first.</p></div>"
            give back b
        end
        let unique be q["mode"] is "brew"
        let result be ai_deck_validated(idea, game, unique)
        let parsed be parse_decklist(result)
        # surface AI/auth/empty failures clearly instead of rendering an empty deck
        let failed be no
        if "request failed" is in result or "empty response" is in result or length(trim(result)) is 0
            change failed to yes
        end
        if not failed and length(parsed) is 0
            change failed to yes
        end
        if failed
            change b to b + "<div class='card'><p class='big'>Couldn't build a deck.</p>"
            if length(trim(result)) is over 0
                change b to b + "<p>" + html_escape(result) + "</p>"
            end
            if "Unauthorized" is in result or "401" is in result or "key rejected" is in result
                change b to b + "<p class='note'>Your API key was rejected - go to <a href='/settings'>Settings</a> and hit <b>Test connection</b>.</p>"
            otherwise
                change b to b + "<p class='note'>The model didn't return a usable decklist. Try <b>Build</b> again, or switch to a standard (non-thinking) model in <a href='/settings'>Settings</a> like gpt-oss:20b, gpt-4o, or claude-sonnet-4.6.</p>"
            end
            change b to b + "</div>"
            give back b
        end
        let names be []
        for each c in parsed
            add c["name"] to names
        end
        let ids be card_ids(names)
        let heading be "Your deck"
        if unique
            change heading to "A fresh brew"
        end
        change b to b + "<h2>" + heading + " - " + html_escape(game) + "</h2>"
        let maincount be 0
        let extracount be 0
        for each c in parsed
            if c["zone"] is "extra"
                change extracount to extracount + c["amount"]
            otherwise
                change maincount to maincount + c["amount"]
            end
        end
        change b to b + "<p class='note'>Main Deck: <b>" + text(maincount) + "</b> cards &middot; Extra Deck: <b>" + text(extracount) + "</b> cards</p>"
        if maincount is under 38
            change b to b + "<p class='note' style='color:#e7b25a'>The AI returned a partial main deck (" + text(maincount) + "/40) - hit Build again for a full 40-card list.</p>"
        end
        if length(parsed) is over 0
            change b to b + decklist_art(parsed, ids)
        end
        change b to b + "<div class='card'><pre class='dlist'>" + html_escape(result) + "</pre></div>"
        change b to b + "<p class='note'>AI-generated - double-check each card is available and unbanned in " + html_escape(game) + " before you craft. Copy the names above to find them in-game.</p>"
    end
    give back b
end

# ---- API + routing ---------------------------------------------------
to cors_json(obj)
    give back {"status": 200, "body": obj, "type": "application/json", "headers": {"Access-Control-Allow-Origin": "*"}}
end

# Parse an x-www-form-urlencoded POST body into a map (url-decoded).
to parse_form(body)
    let out be {}
    for each pair in split(body, "&")
        if "=" is in pair
            let kv be split(pair, "=")
            let k be url_decode(kv[0])
            let v be url_decode(join(kv[1:length(kv)], "="))
            let kk be k
            change out at kk to v
        end
    end
    give back out
end

to handle(req)
    let path be req["path"]
    let q be req["query"]
    # merge POST form fields into the query map so forms can POST (e.g. the API key)
    if req["method"] is "POST" and length(req["body"]) is over 0
        let fields be parse_form(req["body"])
        for each k in keys(fields)
            let kk be k
            change q at kk to fields[k]
        end
    end
    if path is "/api/meta"
        let meta be fetch_meta()
        give back cors_json({"source": meta_source, "top": meta["top"]})
    end
    if path is "/api/counters"
        let meta be fetch_meta()
        give back cors_json(counter_the_meta(meta["top"]))
    end
    if path is "/api/analyze"
        let nm be ""
        if "deck" is in q
            change nm to q["deck"]
        end
        give back cors_json({"deck": nm, "analysis": analyze(nm)})
    end
    if path is "/api/card"
        let cid be ""
        if "id" is in q
            change cid to q["id"]
        end
        if cid is ""
            give back cors_json({"name": "", "desc": "", "meta": ""})
        end
        give back cors_json(fetch_card(cid))
    end
    if path is "/"
        give back page("Meta", meta_body())
    end
    if path is "/decks"
        give back page("Top Decks", decks_body(q))
    end
    if path is "/analyze"
        give back page("Analyze", analyze_body(q))
    end
    if path is "/counters"
        give back page("Counters", counters_body(q))
    end
    if path is "/build"
        give back page("Builder", build_body(q))
    end
    if path is "/deckbuild"
        give back page("Auto-Build", deckbuild_body(q))
    end
    if path is "/ai"
        give back page("AI", ai_body(q))
    end
    if path is "/settings"
        give back page("Settings", settings_body(q))
    end
    give back {"status": 404, "body": page("Lost", "<h1>Off the meta</h1><p><a href='/'>Back to the meta</a>.</p>")}
end

say "Topdeck - Master Duel meta analyzer. Open http://localhost:8090"
serve(8090, handle)
