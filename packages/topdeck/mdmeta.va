let kb be {}
let kb_names be []
for each row in kb_src
    let f be split(row, "|")
    let nm be trim(f[0])
    add nm to kb_names
    let entry be {"name": nm, "tier": trim(f[1]), "summary": trim(f[2]), "weak_to": split(f[3], ","), "tech": split(f[4], ","), "beats": split(f[5], ","), "gameplan": trim(f[6])}
    change kb at nm to entry
end

# ---- live meta layer (cached, with fallback) -------------------------
let meta_cache be nothing
let meta_at be 0
let meta_source be "snapshot"

to tally_decks(decks)
    let counts be {}
    for each d in decks
        let dt be d["deckType"]
        if dt is not nothing
            let nm be dt["name"]
            if nm is in counts
                change counts at nm to counts[nm] + 1
            otherwise
                change counts at nm to 1
            end
        end
    end
    # to a sorted list of {name, count}
    let out be []
    for each k, v in counts
        add {"name": k, "count": v} to out
    end
    give back sort_by(make e give 0 - e["count"], out)
end

to fetch_meta()
    let n be now()
    if meta_cache is not nothing and n - meta_at is under 1800
        give back meta_cache
    end
    attempt
        let res be http_get(META_URL, {"User-Agent": UA})
        if res["status"] is 200
            let decks be from_json(res["body"])
            change meta_cache to {"top": tally_decks(decks), "decks": decks}
            change meta_source to "live"
            change meta_at to n
            give back meta_cache
        end
    rescue e
        change meta_source to "snapshot"
    end
    change meta_cache to {"top": SNAPSHOT, "decks": []}
    change meta_source to "snapshot"
    change meta_at to n
    give back meta_cache
end

# ---- the analysis brain ----------------------------------------------
to analyze(name)
    if name is in kb
        give back kb[name]
    end
    give back nothing
end

# cards that counter the most of the CURRENT top archetypes
to counter_the_meta(top)
    let tally be {}
    let covered be 0
    for each row in top
        let nm be row["name"]
        if nm is in kb
            change covered to covered + 1
            for each card in kb[nm]["weak_to"]
                let c be trim(card)
                if c is in tally
                    change tally at c to tally[c] + 1
                otherwise
                    change tally at c to 1
                end
            end
        end
    end
    let out be []
    for each k, v in tally
        add {"card": k, "answers": v} to out
    end
    give back {"cards": sort_by(make e give 0 - e["answers"], out), "covered": covered}
end

# ---- optional AI mode (bring your own key) ---------------------------
let ai be {"provider": "openrouter", "key": "", "model": "anthropic/claude-sonnet-4.6"}

to ai_base()
    if ai["provider"] is "anthropic"
        give back "https://api.anthropic.com/v1"
    end
    if ai["provider"] is "ollama-cloud"
        give back "https://ollama.com/v1"
    end
    if ai["provider"] is "nvidia"
        give back "https://integrate.api.nvidia.com/v1"
    end
    give back "https://openrouter.ai/api/v1"
end

# Turn providers' confusing auth errors into a clear, actionable message.
to friendly_error(msg)
    let low be lowercase(msg)
    if "missing authentication" is in low or "no auth" is in low or "user not found" is in low or "unauthorized" is in low or "invalid api key" is in low or "no api key" is in low
        give back "API key rejected (\"" + msg + "\") - the key looks invalid or incomplete. Re-copy your FULL key from the provider and Save key again."
    end
    give back msg
end

# Pull a human-readable message out of an API error response.
to api_error_text(j, status)
    if "error" is in j
        let e be j["error"]
        attempt
            give back friendly_error(e["message"])
        rescue ex
            give back friendly_error(text(e))
        end
    end
    if "message" is in j
        give back friendly_error(text(j["message"]))
    end
    give back "unexpected response (HTTP " + text(status) + ")"
end

# A tiny call to verify the key/provider/model actually authenticate.
to ai_ping()
    if ai["key"] is ""
        give back "No key set - paste your API key and Save key first."
    end
    let key be ai["key"]
    let mdl be ai["model"]
    attempt
        if ai["provider"] is "anthropic"
            let abody be {"model": mdl, "max_tokens": 5, "messages": [{"role": "user", "content": "ping"}]}
            let ahdrs be {"x-api-key": key, "anthropic-version": "2023-06-01", "Content-Type": "application/json"}
            let ar be http_post(ai_base() + "/messages", abody, ahdrs)
            let aj be from_json(ar["body"])
            if "content" is in aj
                give back "Connected - " + ai["provider"] + " / " + mdl + " responded."
            end
            give back "Failed (HTTP " + text(ar["status"]) + "): " + api_error_text(aj, ar["status"])
        end
        let body be {"model": mdl, "max_tokens": 5, "messages": [{"role": "user", "content": "ping"}]}
        let hdrs be {"Authorization": "Bearer " + key, "Content-Type": "application/json"}
        let r be http_post(ai_base() + "/chat/completions", body, hdrs)
        let j be from_json(r["body"])
        if "choices" is in j
            give back "Connected - " + ai["provider"] + " / " + mdl + " responded."
        end
        give back "Failed (HTTP " + text(r["status"]) + "): " + api_error_text(j, r["status"])
    rescue e
        give back "Failed: " + e
    end
end

to empty_reply_msg(where)
    give back "The AI returned an empty response" + where + ". This usually means a 'thinking'/reasoning model used its whole token budget reasoning. Switch to a standard (non-thinking) model in Settings - e.g. gpt-oss:20b, gpt-oss:120b, openai/gpt-4o, google/gemini-2.5-flash, or claude-sonnet-4.6."
end

# One generic AI chat call, routed by provider. Returns the reply text.
to ai_chat(sys, user)
    if ai["key"] is ""
        give back "Add an API key in Settings to use AI features."
    end
    let key be ai["key"]
    let mdl be ai["model"]
    let where be " (" + ai["provider"] + " / " + mdl + ")"
    attempt
        if ai["provider"] is "anthropic"
            let abody be {"model": mdl, "max_tokens": 2000, "system": sys, "messages": [{"role": "user", "content": user}]}
            let ahdrs be {"x-api-key": key, "anthropic-version": "2023-06-01", "Content-Type": "application/json"}
            let ar be http_post(ai_base() + "/messages", abody, ahdrs)
            let aj be from_json(ar["body"])
            if "content" is in aj and length(aj["content"]) is over 0
                let txt be aj["content"][0]["text"]
                if trim(txt) is not ""
                    give back txt
                end
                give back empty_reply_msg(where)
            end
            give back "The AI request failed" + where + ": " + api_error_text(aj, ar["status"])
        end
        let body be {"model": mdl, "max_tokens": 2000, "messages": [{"role": "system", "content": sys}, {"role": "user", "content": user}]}
        let hdrs be {"Authorization": "Bearer " + key, "Content-Type": "application/json"}
        let r be http_post(ai_base() + "/chat/completions", body, hdrs)
        let j be from_json(r["body"])
        if "choices" is in j and length(j["choices"]) is over 0
            let msg be j["choices"][0]["message"]
            let content be ""
            if "content" is in msg and msg["content"] is not nothing
                change content to text(msg["content"])
            end
            if trim(content) is "" and "reasoning" is in msg and msg["reasoning"] is not nothing
                change content to text(msg["reasoning"])
            end
            if trim(content) is not ""
                give back content
            end
            give back empty_reply_msg(where)
        end
        give back "The AI request failed" + where + ": " + api_error_text(j, r["status"])
    rescue e
        give back "The AI request failed" + where + ": " + e
    end
end

to meta_context()
    let meta be fetch_meta()
    let context be ""
    for each row in meta["top"][0:10]
        let nm be row["name"]
        change context to context + nm + ", "
    end
    give back context
end

to ai_analyze(question)
    let sys be "You are a Yu-Gi-Oh! Master Duel meta expert. Give concise, practical advice on counters, tech cards, matchups and deck-building. The current live meta (most-played archetypes) is: " + meta_context()
    give back ai_chat(sys, question)
end

# Build (or brew) a full decklist the player can craft in-game.
to ai_deck(idea, game, unique)
    let sys be ""
    if unique
        change sys to "You are a creative Yu-Gi-Oh deck brewer for " + game + ". Design an ORIGINAL, off-meta rogue deck almost nobody plays by COMBINING EXISTING real cards in an unexpected way - e.g. pairing two real archetypes or reviving an underused real engine. Do NOT invent new cards or new archetype names; the originality comes from the combination, not from made-up cards. Give the deck a catchy nickname."
    otherwise
        change sys to "You are an expert Yu-Gi-Oh deck builder for " + game + ". Build a complete, legal, competitive decklist within that game's card pool and current banlist."
    end
    change sys to sys + " Build a COMPLETE, tournament-legal deck: the MAIN DECK must total 40 cards (the counts must add up to 40 - around 17 monsters, a healthy mix of spells and traps), plus an EXTRA DECK of 12-15 cards (Fusion/Synchro/Xyz/Link). CRITICAL RULE: every single card must be a REAL, already-printed Yu-Gi-Oh card that actually exists and is obtainable in " + game + " right now. NEVER invent, rename, or guess at card names - if you are unsure a card is real, do not use it. Use only exact official TCG English names (for example 'Unexpected Dai', not 'Unexpected Guy'). Do not list generic placeholders like 'Normal monster'. FORMAT: print a line 'MAIN DECK', then every main-deck card on its OWN line as 'Nx Exact Official English Card Name', then a line 'EXTRA DECK', then every extra-deck card the same way (precise names only - no rarities, sets, arrows, or notes on card lines). After both lists, add a short 'Gameplan' section. Output ONLY the final deck and gameplan - do NOT show your reasoning, alternatives, corrections, or arrows. Consider today's meta: " + meta_context()
    let user be idea
    if length(trim(idea)) is 0
        change user to "Build a strong, fun deck."
    end
    give back ai_chat(sys, user)
end

# Names in a decklist that don't resolve to a real card (after fuzzy).
to unresolved_names(decktext)
    let parsed be parse_decklist(decktext)
    let names be []
    for each c in parsed
        add c["name"] to names
    end
    let ids be card_ids(names)
    let bad be []
    for each c in parsed
        if not (c["name"] is in ids)
            add c["name"] to bad
        end
    end
    give back bad
end

# Ask the AI to swap any invalid cards for real ones, keeping the format.
to ai_fix_deck(decktext, bad, game)
    let sys be "You are a Yu-Gi-Oh deck doctor for " + game + ". You are given a decklist where some entries are not real cards. Silently replace each invalid entry with a REAL, already-printed card (exact official English name) that fits the strategy and works in " + game + "; keep all valid cards. The result must still be a complete deck: 40 Main Deck cards (counts adding to 40) and 12-15 Extra Deck cards. OUTPUT RULES - output ONLY the final clean decklist and gameplan. Reprint the WHOLE deck from scratch: a 'MAIN DECK' line, each card as 'Nx Exact Card Name', an 'EXTRA DECK' line, each card the same way, then a 'Gameplan' section. Do NOT show what you changed: no arrows (->), no 'Correction', no 'replacing', no 'Duplicate', no 'Wait', no commentary on any card line - just the final clean list."
    let user be "These entries are not real cards: " + join(bad, ", ") + ". Rewrite the full corrected deck.\n\nDecklist:\n" + decktext
    give back ai_chat(sys, user)
end

# Build a deck. To stay within the browser/server timeout we make ONE AI call,
# then at most ONE quick repair pass - and only if that first call was fast (a
# slow model already used most of the time budget; a 2nd call would freeze the
# single-threaded server long enough to look like "can't reach server").
to ai_deck_validated(idea, game, unique)
    let t0 be now()
    let result be ai_deck(idea, game, unique)
    let elapsed be now() - t0
    if "request failed" is in result
        give back result
    end
    if elapsed is over 12
        give back result
    end
    let bad be unresolved_names(result)
    if length(bad) is over 0
        let fixed be ai_fix_deck(result, bad, game)
        if "request failed" is not in fixed
            let newbad be unresolved_names(fixed)
            if length(newbad) is at most length(bad)
                change result to fixed
            end
        end
    end
    give back result
end

# Pull "Nx Card Name" lines out of an AI reply into {name, amount, zone} entries.
to parse_decklist(textval)
    let out be []
    let zone be "main"
    let active be yes
    for each line in split(textval, "\n")
        let t be trim(line)
        let low be lowercase(t)
        # Header/prose lines (not starting with a count) switch sections.
        if length(t) is 0 or not (t[0] is in "0123456789")
            if "extra deck" is in low
                change zone to "extra"
                change active to yes
            end
            if "main deck" is in low
                change zone to "main"
                change active to yes
            end
            if "gameplan" is in low or "game plan" is in low or "combo" is in low or "strategy" is in low or "how it" is in low or "how to" is in low or "win con" is in low or "key card" is in low or "notes" is in low
                change active to no
            end
        end
        if active and length(t) is over 1 and t[0] is in "0123456789"
            let i be 0
            while i is under length(t) and t[i] is in "0123456789"
                change i to i + 1
            end
            let amt be number(t[0:i])
            let rest be trim(t[i:length(t)])
            if length(rest) is over 0 and (rest[0] is "x" or rest[0] is "X")
                change rest to trim(rest[1:length(rest)])
            end
            # cut off any trailing reasoning the model may append after the name
            change rest to trim(split(rest, " (")[0])
            change rest to trim(split(rest, " ->")[0])
            change rest to trim(split(rest, " →")[0])
            # skip lines that are clearly commentary, not a card
            let restl be lowercase(rest)
            let reasoning be no
            if "correction" is in restl or "replacing" is in restl or "duplicate" is in restl or "wait" is in restl or "total" is in restl
                change reasoning to yes
            end
            if not reasoning and length(rest) is over 1 and amt is at least 1 and amt is at most 3
                add {"name": rest, "amount": amt, "zone": zone} to out
            end
        end
    end
    give back out
end

# One clickable card tile. cid 0 -> a card-shaped "no art" placeholder.
# A real Yu-Gi-Oh card-back image with the name overlaid - used whenever a name
# can't be matched to real art, so a slot is never blank.
to card_back_tile(nm, amt, w)
    let badge be ""
    if amt is not nothing
        change badge to "<span class='amt'>" + text(amt) + "</span>"
    end
    give back "<div class='cardback' style='width:" + text(w) + "px' title='" + html_escape(nm) + " - no card art found'><img loading='lazy' src='" + CARD_BACK + "' alt='" + html_escape(nm) + "'><span class='cbname'>" + html_escape(nm) + "</span>" + badge + "</div>"
end

to card_tile(cid, nm, amt)
    let badge be ""
    if amt is not nothing
        change badge to "<span class='amt'>" + text(amt) + "</span>"
    end
    if cid is 0
        give back card_back_tile(nm, amt, 72)
    end
    give back "<div class='cardimg' data-id='" + text(cid) + "' data-name='" + html_escape(nm) + "' title='" + html_escape(nm) + " - click to read'><img loading='lazy' src='https://images.ygoprodeck.com/images/cards_small/" + text(cid) + ".jpg' alt='" + html_escape(nm) + "'>" + badge + "</div>"
end

to cards_row(list, ids)
    let h be "<div class='cards'>"
    for each c in list
        let nm be c["name"]
        let amt be c["amount"]
        if nm is in ids
            change h to h + card_tile(ids[nm], nm, amt)
        otherwise
            change h to h + card_tile(0, nm, amt)
        end
    end
    change h to h + "</div>"
    give back h
end

to decklist_art(parsed, ids)
    let main be []
    let extra be []
    for each c in parsed
        if c["zone"] is "extra"
            add c to extra
        otherwise
            add c to main
        end
    end
    let h be ""
    if length(main) is over 0
        change h to h + "<h3 class='dsec'>Main Deck</h3>" + cards_row(main, ids)
    end
    if length(extra) is over 0
        change h to h + "<h3 class='dsec'>Extra Deck</h3>" + cards_row(extra, ids)
    end
    give back h
end

# Sensible defaults per provider when a live list can't be fetched.
to curated_models(prov)
    if prov is "ollama-cloud"
        give back ["gpt-oss:120b", "gpt-oss:20b", "deepseek-v3.1:671b", "qwen3-coder:480b", "kimi-k2:1t", "glm-4.6", "minimax-m2", "qwen3-vl:235b", "gemma3:27b"]
    end
    if prov is "anthropic"
        give back ["claude-opus-4-8", "claude-sonnet-4-6", "claude-haiku-4-5-20251001"]
    end
    if prov is "nvidia"
        give back ["meta/llama-3.1-405b-instruct", "deepseek-ai/deepseek-r1", "qwen/qwen2.5-coder-32b-instruct"]
    end
    give back ["anthropic/claude-sonnet-4.6", "openai/gpt-4o", "google/gemini-2.5-flash"]
end

# Live model list for the CURRENT provider (OpenAI-compatible /models), cached
# per provider. OpenRouter + Ollama Cloud are public; nvidia/anthropic use the key.
let models_cache be {}
to provider_models()
    let prov be ai["provider"]
    if prov is in models_cache
        give back models_cache[prov]
    end
    let url be "https://openrouter.ai/api/v1/models"
    let hdrs be {"User-Agent": UA}
    if prov is "ollama-cloud"
        change url to "https://ollama.com/v1/models"
    end
    if prov is "nvidia"
        change url to "https://integrate.api.nvidia.com/v1/models"
        if ai["key"] is not ""
            change hdrs to {"User-Agent": UA, "Authorization": "Bearer " + ai["key"]}
        end
    end
    if prov is "anthropic"
        change url to "https://api.anthropic.com/v1/models"
        if ai["key"] is not ""
            change hdrs to {"User-Agent": UA, "x-api-key": ai["key"], "anthropic-version": "2023-06-01"}
        end
    end
    let out be []
    attempt
        let r be http_get(url, hdrs)
        if r["status"] is 200
            let data be from_json(r["body"])["data"]
            for each m in data
                add m["id"] to out
            end
            change out to sort(out)
        end
    rescue e
        change out to []
    end
    if length(out) is over 0
        let pk be prov
        change models_cache at pk to out
        give back out
    end
    give back curated_models(prov)
end

