# V-NOx 1 - the first operating system written in Vanta.
# A desktop environment served entirely by this Vanta program: window manager,
# virtual filesystem, Vanta Studio, and apps. Run a fresh Chrome app-window at
# http://localhost:8100 (see boot.va) for the full-screen OS feel.

let PORT be 8100
let VNOX_HOME be path_join(home_dir(), ".vnox")
let FS_ROOT be path_join(VNOX_HOME, "fs")
let STATE_FILE be path_join(VNOX_HOME, "state.json")

let state be {"accent": "#4c8dff", "wallpaper": "aurora", "provider": "openrouter", "model": "openai/gpt-4o", "key": ""}

to ensure_home()
    make_dir(VNOX_HOME)
    make_dir(FS_ROOT)
    let docs be path_join(FS_ROOT, "Documents")
    make_dir(docs)
    let w be path_join(FS_ROOT, "welcome.va")
    if not path_exists(w)
        write_file(w, "say \"Welcome to V-NOx 1 - the first OS made in Vanta.\"\nlet n be 0\nfor each i in range(1, 6)\n    change n to n + i\nend\nsay \"sum 1..5 = \" + text(n)\n")
    end
    let r be path_join(FS_ROOT, "Documents", "notes.txt")
    if not path_exists(r)
        write_file(r, "My first note inside V-NOx.\n")
    end
end

to load_state()
    if path_exists(STATE_FILE)
        attempt
            let raw be read_file(STATE_FILE)
            let m be from_json(raw)
            for each k in keys(m)
                let kk be k
                change state at kk to m[k]
            end
        rescue e
            change state to state
        end
    end
end

to save_state()
    write_file(STATE_FILE, to_json(state))
end

# ---- virtual filesystem (sandboxed under FS_ROOT) -------------------------
to safe_path(rel)
    let clean be rel
    if starts_with(clean, "/")
        change clean to slice(clean, 1, length(clean))
    end
    if ".." is in clean
        change clean to ""
    end
    if clean is ""
        give back FS_ROOT
    end
    give back path_join(FS_ROOT, clean)
end

to fs_list(rel)
    let dir be safe_path(rel)
    let out be []
    if not is_dir(dir)
        give back {"path": rel, "entries": out}
    end
    for each name in list_dir(dir)
        if not starts_with(name, ".")
            let full be path_join(dir, name)
            let isd be is_dir(full)
            let sz be 0
            if not isd
                change sz to file_size(full)
            end
            add {"name": name, "dir": isd, "size": sz} to out
        end
    end
    give back {"path": rel, "entries": out}
end

# ---- AI (bring-your-own-key, same provider routing as Topdeck) ------------
to ai_base()
    if state["provider"] is "anthropic"
        give back "https://api.anthropic.com/v1"
    end
    if state["provider"] is "ollama-cloud"
        give back "https://ollama.com/v1"
    end
    if state["provider"] is "nvidia"
        give back "https://integrate.api.nvidia.com/v1"
    end
    give back "https://openrouter.ai/api/v1"
end

to ai_chat(prompt)
    if state["key"] is ""
        give back "Set an API key in Settings to use the assistant."
    end
    attempt
        if state["provider"] is "anthropic"
            let ab be {"model": state["model"], "max_tokens": 1200, "messages": [{"role": "user", "content": prompt}]}
            let ah be {"x-api-key": state["key"], "anthropic-version": "2023-06-01", "Content-Type": "application/json"}
            let ar be http_post(ai_base() + "/messages", ab, ah)
            let aj be from_json(ar["body"])
            if "content" is in aj and length(aj["content"]) is over 0
                give back aj["content"][0]["text"]
            end
            give back "Assistant error (HTTP " + text(ar["status"]) + ")."
        end
        let body be {"model": state["model"], "max_tokens": 1200, "messages": [{"role": "user", "content": prompt}]}
        let hdrs be {"Authorization": "Bearer " + state["key"], "Content-Type": "application/json"}
        let r be http_post(ai_base() + "/chat/completions", body, hdrs)
        let j be from_json(r["body"])
        if "choices" is in j and length(j["choices"]) is over 0
            give back j["choices"][0]["message"]["content"]
        end
        give back "Assistant error (HTTP " + text(r["status"]) + ")."
    rescue e
        give back "Assistant request failed: " + e
    end
end

# ---- POST body parsing ----------------------------------------------------
to body_json(req)
    attempt
        give back from_json(req["body"])
    rescue e
        give back {}
    end
end

to cors_json(obj)
    give back {"status": 200, "body": obj, "type": "application/json", "headers": {"Access-Control-Allow-Origin": "*"}}
end

