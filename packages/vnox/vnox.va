to desktop_js()
    let j be "(function(){{"
    change j to j + "var Z=20,WINS={{}},ORD=[];"
    change j to j + "var APPS={{studio:{{t:'Vanta Studio',i:'&lt;/&gt;',w:780,h:540}},files:{{t:'Files',i:'&#128193;',w:700,h:470}},terminal:{{t:'Terminal',i:'&gt;_',w:680,h:430}},settings:{{t:'Settings',i:'&#9881;',w:660,h:520}},calc:{{t:'Calculator',i:'=',w:300,h:430}},clock:{{t:'Clock',i:'&#128347;',w:320,h:300}},about:{{t:'About V-NOx',i:'&#9670;',w:500,h:400}},browser:{{t:'Browser',i:'&#127760;',w:880,h:600}},topdeck:{{t:'Topdeck',i:'&#9824;',w:1060,h:680,url:'http://localhost:8090'}},vaeldric:{{t:'Vaeldric',i:'&#10022;',w:1060,h:680,url:'http://localhost:8080'}}}};"
    change j to j + "function elx(t,c,h){{var e=document.createElement(t);if(c)e.className=c;if(h!=null)e.innerHTML=h;return e;}}"
    change j to j + "function desk(){{return document.getElementById('desk');}}"
    change j to j + "function postj(u,o,cb){{fetch(u,{{method:'POST',headers:{{'Content-Type':'application/json'}},body:JSON.stringify(o)}}).then(function(r){{return r.json();}}).then(cb);}}"
    change j to j + "function getj(u,cb){{fetch(u).then(function(r){{return r.json();}}).then(cb);}}"
    # ---- window management ----
    change j to j + "function openApp(id){{closeStart();if(WINS[id]){{if(WINS[id].dataset.min==='1')restore(id);focusWin(id);return;}}var a=APPS[id];if(!a)return;var w=elx('div','win');w.dataset.app=id;var n=ORD.length;w.style.width=a.w+'px';w.style.height=a.h+'px';w.style.left=(72+n*26)+'px';w.style.top=(46+n*22)+'px';"
    change j to j + "w.innerHTML='<div class=\"tbar\"><span class=\"tt\">'+a.i+' '+a.t+'</span><span class=\"tctl\"><i data-a=\"min\">&#8211;</i><i data-a=\"max\">&#9633;</i><i data-a=\"x\">&#215;</i></span></div><div class=\"wbody\"></div><div class=\"rsz\"></div>';"
    change j to j + "desk().appendChild(w);WINS[id]=w;ORD.push(id);buildApp(id,w.querySelector('.wbody'));var bar=w.querySelector('.tbar');dragify(w,bar);resizify(w);"
    change j to j + "w.addEventListener('mousedown',function(){{focusWin(id);}});bar.querySelector('.tctl').addEventListener('click',function(e){{var k=e.target.getAttribute('data-a');if(!k)return;e.stopPropagation();if(k==='x')closeWin(id);else if(k==='min')minWin(id);else maxWin(id);}});bar.addEventListener('dblclick',function(){{maxWin(id);}});focusWin(id);renderTasks();}}"
    change j to j + "function dragify(w,bar){{bar.addEventListener('mousedown',function(e){{if(e.target.closest('.tctl'))return;if(w.dataset.max==='1')return;var sx=e.clientX,sy=e.clientY,ox=w.offsetLeft,oy=w.offsetTop;bar.style.cursor='grabbing';function mv(ev){{w.style.left=(ox+ev.clientX-sx)+'px';w.style.top=Math.max(0,oy+ev.clientY-sy)+'px';}}function up(){{document.removeEventListener('mousemove',mv);document.removeEventListener('mouseup',up);bar.style.cursor='grab';}}document.addEventListener('mousemove',mv);document.addEventListener('mouseup',up);}});}}"
    change j to j + "function resizify(w){{w.querySelector('.rsz').addEventListener('mousedown',function(e){{e.stopPropagation();var sx=e.clientX,sy=e.clientY,ow=w.offsetWidth,oh=w.offsetHeight;function mv(ev){{w.style.width=Math.max(280,ow+ev.clientX-sx)+'px';w.style.height=Math.max(160,oh+ev.clientY-sy)+'px';}}function up(){{document.removeEventListener('mousemove',mv);document.removeEventListener('mouseup',up);}}document.addEventListener('mousemove',mv);document.addEventListener('mouseup',up);}});}}"
    change j to j + "function focusWin(id){{for(var k in WINS)WINS[k].classList.remove('active');var w=WINS[id];if(!w)return;w.classList.add('active');w.style.zIndex=++Z;renderTasks();}}"
    change j to j + "function closeWin(id){{if(!WINS[id])return;WINS[id].remove();delete WINS[id];ORD=ORD.filter(function(x){{return x!==id;}});renderTasks();}}"
    change j to j + "function minWin(id){{var w=WINS[id];if(!w)return;w.style.display='none';w.dataset.min='1';w.classList.remove('active');renderTasks();}}"
    change j to j + "function restore(id){{var w=WINS[id];if(!w)return;w.style.display='flex';w.dataset.min='0';}}"
    change j to j + "function maxWin(id){{var w=WINS[id];if(!w)return;if(w.dataset.max==='1'){{w.dataset.max='0';w.style.left=w.dataset.px;w.style.top=w.dataset.py;w.style.width=w.dataset.pw;w.style.height=w.dataset.ph;}}else{{w.dataset.max='1';w.dataset.px=w.style.left;w.dataset.py=w.style.top;w.dataset.pw=w.style.width;w.dataset.ph=w.style.height;w.style.left='0px';w.style.top='0px';w.style.width='100%';w.style.height='100%';}}}}"
    change j to j + "function renderTasks(){{var b=document.getElementById('tasks');b.innerHTML='';ORD.forEach(function(id){{var a=APPS[id],w=WINS[id];var t=elx('div','tk'+((w&&w.dataset.min!=='1'&&w.classList.contains('active'))?' on':''),a.i+' '+a.t);t.addEventListener('click',function(){{if(w.dataset.min==='1'){{restore(id);focusWin(id);}}else if(w.classList.contains('active'))minWin(id);else focusWin(id);}});b.appendChild(t);}});}}"
    # ---- app builders ----
    change j to j + "function buildApp(id,body){{var a=APPS[id];if(a.url){{body.innerHTML='<iframe class=\"frame\" src=\"'+a.url+'\"></iframe>';return;}}if(id==='studio')return studioApp(body);if(id==='files')return filesApp(body);if(id==='terminal')return termApp(body);if(id==='settings')return settingsApp(body);if(id==='calc')return calcApp(body);if(id==='clock')return clockApp(body);if(id==='browser')return browserApp(body);body.innerHTML='<div class=\"pad\"><h2 style=\"margin-top:0\">V-NOx 1</h2><p>The first operating system written in <b>Vanta</b> - window manager, virtual filesystem and apps, all served by one Vanta program. Vanta Studio runs Vanta in-process via the new <code>run_vanta</code> builtin.</p><p style=\"color:#9fb0d8\">Engine: Vanta 4.3 &middot; Display: Chromium &middot; Theme: Midnight Blue</p></div>';}}"
    change j to j + "function studioApp(body){{body.style.display='flex';body.style.flexDirection='column';body.innerHTML='<div class=\"tools\"><button class=\"btn\" id=\"srun\">&#9654; Run</button><button class=\"btn ghost\" id=\"ssave\">Save</button><button class=\"btn ghost\" id=\"sopen\">Open</button><button class=\"btn ghost\" id=\"sai\">Ask AI</button><span id=\"sfn\" style=\"color:#9fb0d8;font-size:12px;margin-left:auto\">untitled.va</span></div><textarea class=\"ed\" id=\"sed\" spellcheck=\"false\"></textarea><div class=\"con\" id=\"scon\">Console - write Vanta, press Run.</div>';"
    change j to j + "var ed=body.querySelector('#sed'),con=body.querySelector('#scon'),fn=body.querySelector('#sfn');ed.value='say \"Hello from V-NOx!\"\\nsay \"2 + 2 = \" + text(2 + 2)\\n';"
