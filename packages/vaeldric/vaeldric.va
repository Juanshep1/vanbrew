add {"en": "no", "va": "naevi", "pos": "Function", "root": "Particle; OE na"} to vocab
add {"en": "to", "va": "tov", "pos": "Function", "root": "Preposition; OE to"} to vocab
add {"en": "with", "va": "midael", "pos": "Function", "root": "Preposition; OE mid"} to vocab
add {"en": "in / into", "va": "inael", "pos": "Function", "root": "Preposition; OE in"} to vocab
add {"en": "of / from", "va": "aev", "pos": "Function", "root": "Preposition; ab + of"} to vocab
add {"en": "through", "va": "oruthael", "pos": "Function", "root": "Vel-shift: through"} to vocab
add {"en": "now", "va": "nuael", "pos": "Function", "root": "Adverb; OE nu"} to vocab
add {"en": "here", "va": "hierael", "pos": "Function", "root": "Adverb; OE her"} to vocab
add {"en": "there", "va": "aerethael", "pos": "Function", "root": "Adverb; OE thaer"} to vocab
add {"en": "always", "va": "aeverael", "pos": "Function", "root": "Adverb; OE aefre"} to vocab
add {"en": "never", "va": "naeverael", "pos": "Function", "root": "naen + aeverael"} to vocab
add {"en": "today", "va": "daegel-nuael", "pos": "Function", "root": "day + now"} to vocab
add {"en": "all / every", "va": "alael", "pos": "Function", "root": "Determiner; OE eall"} to vocab
add {"en": "more", "va": "morel", "pos": "Function", "root": "Determiner; OE mara"} to vocab
add {"en": "only", "va": "aenil", "pos": "Function", "root": "Determiner; OE anlic"} to vocab
add {"en": "question marker", "va": "kael", "pos": "Function", "root": "Particle; OE hwa"} to vocab
