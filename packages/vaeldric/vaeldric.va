let coinages be {}
let coin_words be []
for each row in coin_src
    let f be split(row, "|")
    let words be split(f[0], ",")
    let primary be trim(words[0])
    add primary to coin_words
    let value be [trim(f[1]), trim(f[2]), trim(f[3])]
    for each word in words
        let key be trim(word)
        change coinages at key to value
    end
end

# ---- the Vel Shift, computed live -----------------------------------

to is_vowel(c)
    give back c is in ["a", "e", "i", "o", "u"]
end

to suffix_for(pos)
    if pos is "verb"
        give back "eth"
    end
    if pos is "adj"
        give back "er"
    end
    if pos is "adv"
        give back "es"
    end
    give back "en"
end

to vel_shift(word, suffix)
    let w be lowercase(trim(word))
    if length(w) is 0
        give back ""
    end
    if is_vowel(w[0])
        give back "v" + w + suffix
    end
    let i be 0
    while i is under length(w) and not is_vowel(w[i])
        change i to i + 1
    end
    let cluster be w[0:i]
    let stem be w[i:length(w)]
    give back stem + cluster + suffix
end

# Is this English word already a core word? Return its Vaeldric form or nothing.
to core_lookup(word)
    for each entry in vocab
        let parts be split(lowercase(entry["en"]), "/")
        for each pt in parts
            if trim(pt) is word
                give back entry["va"]
            end
        end
    end
    give back nothing
end

# ---- the translator -------------------------------------------------

to strip_punct(w)
    let out be ""
    let i be 0
    while i is under length(w)
        let c be w[i]
        if c is in "abcdefghijklmnopqrstuvwxyz0123456789-"
            change out to out + c
        end
        change i to i + 1
    end
    give back out
end

to en_lookup(word)
    if word is in extra
        give back extra[word]
    end
    give back core_lookup(word)
end

to pluralize(va)
    if ends_with(va, "en")
        give back va[0:length(va) - 2] + "eni"
    end
    give back va + "i"
end

# English -> Vaeldric: core words and inflections by table, everything else by
# the Vel Shift; tense/negation/question handled with particles.
to en_to_va(text)
    let low be lowercase(trim(text))
    let question be ends_with(low, "?")
    let out be []
    if question
        add "kael" to out
    end
    for each w in split(low, " ")
        let clean be strip_punct(w)
        if clean is ""
            skip
        end
        if question and clean is in ["do", "does"]
            skip
        end
        if clean is in ["not", "dont", "doesnt", "didnt", "wont", "cant", "cannot", "never", "no"]
            add "naen" to out
            skip
        end
        if clean is in ["will", "shall"]
            add "veld" to out
            skip
        end
        if clean is in ["was", "were", "did"]
            add "eld" to out
            skip
        end
        let va be en_lookup(clean)
        if va is not nothing
            add va to out
            skip
        end
        if ends_with(clean, "s") and length(clean) is over 2
            let singular be clean[0:length(clean) - 1]
            let sv be en_lookup(singular)
            if sv is not nothing
                add pluralize(sv) to out
                skip
            end
        end
        let c be coin(clean)
        add c["vaeldric"] to out
    end
    give back join(out, " ")
end

# Vaeldric -> English: reverse vocabulary lookup + particles. Best for text
# built from the core words.
to va_to_en(text)
    let out be []
    let question be no
    for each w in split(lowercase(trim(text)), " ")
        let clean be strip_punct(w)
        if clean is ""
            skip
        end
        if clean is "kael"
            change question to yes
            skip
        end
        if clean is "eld"
            add "(past)" to out
            skip
        end
        if clean is "veld"
            add "(will)" to out
            skip
        end
        if clean is "naen"
            add "not" to out
            skip
        end
        if clean is "aev"
            add "of" to out
            skip
        end
        if clean is in va_en
            add va_en[clean] to out
            skip
        end
        if ends_with(clean, "eni")
            let sing be clean[0:length(clean) - 3] + "en"
            if sing is in va_en
                add va_en[sing] + "s" to out
                skip
            end
        end
        add "?" + clean to out
    end
    let sentence be join(out, " ")
    if question
        give back sentence + "?"
    end
    give back sentence
end

# Coin a Vaeldric word for a modern concept from native roots, or fall back to
# the plain Vel Shift if we have no kenning for it yet.
to coin(word)
    let w be lowercase(trim(word))
    if w is in coinages
        let parts be coinages[w]
        let stem be parts[0]
        let tail be parts[1]
        let gloss be parts[2]
        let compound be respell(stem + tail)
        give back {"english": w, "vaeldric": compound, "hyphen": stem + "-" + respell(tail), "gloss": gloss, "coined": yes}
    end
    give back {"english": w, "vaeldric": vel_shift(w, "en"), "hyphen": "", "gloss": "no coinage yet - Vel Shift", "coined": no}
end

# ---- shared page chrome ---------------------------------------------

to styles()
    let s be ""
    change s to s + "*{{box-sizing:border-box}}"
    change s to s + "body{{margin:0;background:#0d0c13;color:#e9e3d6;font-family:'Iowan Old Style','Palatino',Georgia,serif;line-height:1.65}}"
    change s to s + "a{{color:#c9a86a;text-decoration:none}}"
    change s to s + "nav{{display:flex;flex-wrap:wrap;gap:18px;align-items:center;padding:16px 28px;border-bottom:1px solid #2a2738;background:#100e18;position:sticky;top:0}}"
    change s to s + "nav a{{font-size:15px;letter-spacing:.5px;color:#b8b0c4}}"
    change s to s + "nav a:hover{{color:#e9d9b0}}"
    change s to s + "nav .brand{{font-size:20px;font-weight:700;letter-spacing:3px;color:#d8b878;margin-right:auto}}"
    change s to s + "main{{max-width:820px;margin:0 auto;padding:36px 28px 80px}}"
    change s to s + "h1{{font-size:34px;color:#e9d9b0;margin:.2em 0 .4em;letter-spacing:1px}}"
    change s to s + "h2{{font-size:23px;color:#c9a86a;margin:1.6em 0 .4em;border-bottom:1px solid #26233380;padding-bottom:6px}}"
    change s to s + "p{{margin:.7em 0}}"
    change s to s + ".lede{{font-size:19px;color:#cfc7b6}}"
    change s to s + ".va{{color:#e9d9b0;font-weight:600}}"
    change s to s + ".quote{{font-size:20px;color:#d8b878;font-style:italic;border-left:3px solid #c9a86a;padding:6px 18px;margin:18px 0;background:#15131f}}"
    change s to s + ".quote .t{{display:block;color:#9a93a8;font-size:15px;font-style:normal;margin-top:6px}}"
    change s to s + "table{{border-collapse:collapse;width:100%;margin:14px 0}}"
    change s to s + "th,td{{text-align:left;padding:8px 12px;border-bottom:1px solid #242031}}"
    change s to s + "th{{color:#9a93a8;font-size:13px;letter-spacing:1px;text-transform:uppercase}}"
    change s to s + "td.v{{color:#e9d9b0;font-weight:600;font-size:18px}}"
    change s to s + ".card{{background:#15131f;border:1px solid #2a2738;border-radius:14px;padding:20px 22px;margin:16px 0}}"
    change s to s + ".grid{{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}}"
    change s to s + ".chip{{background:#15131f;border:1px solid #2a2738;border-radius:10px;padding:12px 14px}}"
    change s to s + ".chip .v{{font-size:19px}}.chip .e{{color:#9a93a8;font-size:14px}}"
    change s to s + "input,select{{font:inherit;font-size:17px;padding:10px 12px;background:#0d0c13;color:#e9e3d6;border:1px solid #3a3550;border-radius:9px}}"
    change s to s + "button{{font:inherit;font-size:16px;padding:10px 18px;background:#c9a86a;color:#1a1525;border:0;border-radius:9px;font-weight:700;cursor:pointer}}"
    change s to s + "form{{display:flex;gap:10px;flex-wrap:wrap;margin:16px 0}}"
    change s to s + ".result{{font-size:26px;margin:18px 0;padding:18px 20px;background:#15131f;border:1px solid #2a2738;border-radius:12px}}"
    change s to s + ".result .en{{color:#9a93a8}}.result .va{{color:#e9d9b0}}"
    change s to s + ".note{{font-size:14px;color:#9a93a8}}"
    change s to s + ".story p.va{{font-size:20px;margin:.6em 0 .1em}}"
    change s to s + ".story p.en{{color:#b8b0c4;margin:.1em 0}}"
    change s to s + ".story p.gloss{{color:#6f6982;font-size:13px;margin:.1em 0 1.2em}}"
    change s to s + ".opt{{display:block;background:#15131f;border:1px solid #2a2738;border-radius:10px;padding:14px 18px;margin:10px 0;color:#e9e3d6;font-size:18px}}"
    change s to s + ".opt:hover{{border-color:#c9a86a;color:#e9d9b0}}"
    change s to s + ".big{{font-size:40px;color:#e9d9b0;text-align:center;letter-spacing:1px;margin:10px 0}}"
    change s to s + ".ok{{color:#7fcf9a}}.no{{color:#e07a7a}}"
    change s to s + "footer{{text-align:center;color:#6f6982;padding:30px;border-top:1px solid #242031;font-style:italic}}"
    give back s
end

to nav()
    let n be "<nav><a class='brand' href='/'>VAELDRIC</a>"
    change n to n + "<a href='/alphabet'>Sounds</a>"
    change n to n + "<a href='/shift'>Vel Shift</a>"
    change n to n + "<a href='/grammar'>Grammar</a>"
    change n to n + "<a href='/words'>Words</a>"
    change n to n + "<a href='/read'>Read</a>"
    change n to n + "<a href='/quiz'>Quiz</a></nav>"
    give back n
end

to page(title, body)
    let h be "<!doctype html><html><head><meta charset='utf-8'>"
    change h to h + "<meta name='viewport' content='width=device-width,initial-scale=1'>"
    change h to h + "<title>" + title + " - Vaeldric</title><style>" + styles() + "</style></head><body>"
    change h to h + nav()
    change h to h + "<main>" + body + "</main>"
    change h to h + "<footer>Sooth tha tungen. - True the tongue.</footer></body></html>"
    give back h
end

# ---- pages ----------------------------------------------------------

to home_body()
    let b be "<h1>Tha Tungael Vaeldric</h1>"
    change b to b + "<p class='lede'>The True-Realm Tongue - a constructed language of Old English and Latin roots, with a grammar a speaker of English already half-knows. Learn it here, one rule at a time.</p>"
    change b to b + "<div class='quote'>Mael itewreth mael aev soothen vaen tha daegel nuael. Tha tungen isen mael aev. Alael wordeni isen soothir."
    change b to b + "<span class='t'>I write my truth on this day now. The tongue is mine. All words are true.</span></div>"
    change b to b + "<h2>The four endings that build the language</h2>"
    change b to b + "<div class='grid'>"
    change b to b + "<div class='chip'><div class='v'>-en</div><div class='e'>noun &middot; 'pen'</div></div>"
    change b to b + "<div class='chip'><div class='v'>-eth</div><div class='e'>verb &middot; 'breath'</div></div>"
    change b to b + "<div class='chip'><div class='v'>-er</div><div class='e'>adjective &middot; 'her'</div></div>"
    change b to b + "<div class='chip'><div class='v'>-es</div><div class='e'>adverb &middot; 'less'</div></div>"
    change b to b + "</div>"
    change b to b + "<h2>Start here</h2>"
    change b to b + "<p>1. Learn the <a href='/alphabet'>sounds</a>. 2. Master the <a href='/shift'>Vel Shift</a> - turn any English word into Vaeldric. 3. Learn the <a href='/grammar'>seven laws</a>. 4. Drill the <a href='/words'>hundred words</a>. 5. <a href='/read'>Read a story</a>, then <a href='/quiz'>test yourself</a>.</p>"
    give back b
end

to alphabet_body()
    let b be "<h1>The Sounds of Vaeldric</h1>"
    change b to b + "<p>Vaeldric has seven vowels and two signature diphthongs. The vowel <span class='va'>ae</span> is its sonic fingerprint - a pure, held 'a' as in 'day', never the English glide.</p>"
    change b to b + "<table><tr><th>Sound</th><th>Spelling</th><th>Like</th></tr>"
    let vowels be []
    add ["/a/", "a", "'a' in father"] to vowels
    add ["/ae/", "ae", "'a' in day, held long - the signature vowel"] to vowels
    add ["/e/", "e", "'e' in bed"] to vowels
    add ["/i/", "i", "'i' in bit"] to vowels
    add ["/ei/", "ei", "'ay-il', a true diphthong"] to vowels
    add ["/o/", "o", "'o' in more"] to vowels
    add ["/u/", "u", "'oo' in moon"] to vowels
    for each row in vowels
        change b to b + "<tr><td class='v'>" + row[0] + "</td><td class='v'>" + row[1] + "</td><td>" + row[2] + "</td></tr>"
    end
    change b to b + "</table>"
    change b to b + "<h2>The four part-of-speech suffixes</h2>"
    change b to b + "<table><tr><th>Suffix</th><th>Class</th><th>Say</th><th>Notes</th></tr>"
    change b to b + "<tr><td class='v'>-en</td><td>noun</td><td>en</td><td>plural becomes -eni</td></tr>"
    change b to b + "<tr><td class='v'>-eth</td><td>verb</td><td>eth</td><td>never conjugates</td></tr>"
    change b to b + "<tr><td class='v'>-er</td><td>adjective</td><td>er</td><td>comparative -ern, superlative -erst</td></tr>"
    change b to b + "<tr><td class='v'>-es</td><td>adverb</td><td>es</td><td>the English '-ly'</td></tr>"
    change b to b + "</table>"
    change b to b + "<p class='note'>Stress falls on the suffix vowel of longer words, giving Vaeldric its rising cadence. Double consonants are held longer, as in Italian.</p>"
    give back b
end

to shift_body(q)
    let cur be ""
    if "word" is in q
        change cur to q["word"]
    end
    let b be "<h1>The Vel Shift</h1>"
    change b to b + "<p>The rule that turns <em>any</em> English word into Vaeldric, so you are never without a word.</p>"
    change b to b + "<div class='card'><b>Starts with consonants:</b> move the leading consonant cluster to the end, then add the suffix.<br>think &rarr; <span class='va'>ink + th + -eth = inktheth</span><br><br>"
    change b to b + "<b>Starts with a vowel:</b> add <span class='va'>v-</span> to the front, then the suffix.<br>eat &rarr; <span class='va'>v + eat + -eth = veateth</span></div>"
    change b to b + "<h2>Try it</h2>"
    change b to b + "<form method='get' action='/shift'>"
    change b to b + "<input name='word' placeholder='an English word...' value='" + cur + "'>"
    change b to b + "<select name='pos'><option value='noun'>noun</option><option value='verb'>verb</option><option value='adj'>adjective</option><option value='adv'>adverb</option></select>"
    change b to b + "<button>Shift it</button></form>"
    if "word" is in q
        let w be trim(lowercase(q["word"]))
        if length(w) is over 0
            let pos be "noun"
            if "pos" is in q
                change pos to q["pos"]
            end
            let result be vel_shift(w, suffix_for(pos))
            change b to b + "<div class='result'><span class='en'>" + w + "</span> &rarr; <span class='va'>" + result + "</span></div>"
            let core be core_lookup(w)
            if core is not nothing
                change b to b + "<p class='note'>This is a <b>core word</b>: <span class='va'>" + core + "</span>. Core vocabulary is never shifted - use the canonical form above in real writing.</p>"
            end
        end
    end
    give back b
end

to grammar_body()
    let b be "<h1>The Seven Laws</h1>"
    change b to b + "<p>No gender, no cases, no conjugation, no irregular forms. If you know English sentence order, you know Vaeldric order.</p>"
    let laws be []
    add ["I - Word order", "Subject then Verb then Object. Always. <span class='va'>Mael luveil tael.</span> = I love you."] to laws
    add ["II - No conjugation", "Verbs end in -eth and never change. <span class='va'>mael luveth, herel luveth, wael luveth</span> = I/he/we love."] to laws
    add ["III - Tense by particle", "<span class='va'>eld</span> (past) or <span class='va'>veld</span> (future) before the verb; nothing = present. <span class='va'>Mael eld itewreth / itewreth / veld itewreth</span> = I wrote / write / will write."] to laws
    add ["IV - Plural by -eni", "Change -en to -eni. <span class='va'>worden &rarr; wordeni</span> = word &rarr; words."] to laws
    add ["V - Questions by kael", "Begin with <span class='va'>kael</span>; do not invert. <span class='va'>Kael tael witten tha paethael?</span> = Do you know the path?"] to laws
    add ["VI - Negation by naen", "Put <span class='va'>naen</span> before what you negate. <span class='va'>Mael naen willen.</span> = I do not want."] to laws
    add ["VII - Possession by aev", "Possessor + <span class='va'>aev</span> + thing. <span class='va'>mael aev gaestael</span> = my soul (I-of soul)."] to laws
    for each law in laws
        change b to b + "<div class='card'><h2 style='margin-top:0;border:0'>" + law[0] + "</h2>" + law[1] + "</div>"
    end
    change b to b + "<h2>Adjectives and adverbs come after</h2>"
    change b to b + "<p><span class='va'>tha soothen bierhter</span> = the bright truth (lit. the truth bright). Comparatives add -ern, superlatives add -erst: <span class='va'>boner &rarr; bonern &rarr; bonerst</span> = good, better, best.</p>"
    give back b
end

to words_body()
    let b be "<h1>The Hundred Words</h1>"
    change b to b + "<p>The founding vocabulary - etymologically chosen, never shifted. Master these plus the Vel Shift and you can say anything.</p>"
    let cats be ["Pronoun", "Verb", "Noun", "Adjective", "Function"]
    for each cat in cats
        change b to b + "<h2>" + cat + "s</h2><table><tr><th>English</th><th>Vaeldric</th><th>Root</th></tr>"
        for each entry in vocab
            if entry["pos"] is cat
                change b to b + "<tr><td>" + entry["en"] + "</td><td class='v'>" + entry["va"] + "</td><td class='note'>" + entry["root"] + "</td></tr>"
            end
        end
        change b to b + "</table>"
    end
    give back b
end

to story(st)
    let h be "<div class='story'><h2>" + st["title"] + "</h2><p class='note'>" + st["subtitle"] + "</p>"
    for each ln in st["lines"]
        change h to h + "<p class='va'>" + ln["va"] + "</p><p class='en'>" + ln["en"] + "</p><p class='gloss'>" + ln["gloss"] + "</p>"
    end
    change h to h + "</div>"
    give back h
end

to read_body()
    let b be "<h1>Read</h1><p>Each line shows Vaeldric, its English meaning, and a word-by-word gloss - the linguist's way to learn to read a tongue.</p>"
    for each st in stories
        change b to b + story(st)
    end
    give back b
end

to quiz_body(q)
    let n be length(vocab)
    let b be "<h1>Quiz</h1>"

    # result screen
    if "p" is in q
        let qi be number(q["qi"])
        let pi be number(q["p"])
        let right be vocab[qi]
        if qi is pi
            change b to b + "<p class='big ok'>Soothir! Correct.</p>"
        otherwise
            change b to b + "<p class='big no'>Naen - not quite.</p>"
            change b to b + "<p style='text-align:center'>You chose <b>" + vocab[pi]["en"] + "</b>.</p>"
        end
        change b to b + "<p style='text-align:center;font-size:22px'><span class='va'>" + right["va"] + "</span> = " + right["en"] + "</p>"
        change b to b + "<p style='text-align:center'><a class='opt' style='display:inline-block' href='/quiz'>Next word &rarr;</a></p>"
        give back b
    end

    # new question: correct + three distractors
    let qi be random(0, n - 1)
    let opts be [qi]
    while length(opts) is under 4
        let r be random(0, n - 1)
        if not (r is in opts)
            add r to opts
        end
    end
    # shuffle by a few random swaps
    repeat 6 times
        let i be random(0, 3)
        let j be random(0, 3)
        let tmp be opts[i]
        change opts at i to opts[j]
        change opts at j to tmp
    end

    change b to b + "<p style='text-align:center'>What does this word mean?</p>"
    change b to b + "<p class='big'>" + vocab[qi]["va"] + "</p>"
    for each o in opts
        change b to b + "<a class='opt' href='/quiz?qi=" + qi + "&p=" + o + "'>" + vocab[o]["en"] + "</a>"
    end
    give back b
end

# ---- the server -----------------------------------------------------

# ---- JSON API (so the Next.js frontend can use Vanta as its engine) -

to cors_json(obj)
    give back {"status": 200, "body": obj, "type": "application/json", "headers": {"Access-Control-Allow-Origin": "*"}}
end

# Build a fresh quiz question: a prompt word, four English options, answer index.
to make_question()
    let n be length(vocab)
    let qi be random(0, n - 1)
    let opts be [qi]
    while length(opts) is under 4
        let r be random(0, n - 1)
        if not (r is in opts)
            add r to opts
        end
    end
    repeat 6 times
        let i be random(0, 3)
        let j be random(0, 3)
        let tmp be opts[i]
        change opts at i to opts[j]
        change opts at j to tmp
    end
    let options be []
    let answer be 0
    let k be 0
    for each o in opts
        add vocab[o]["en"] to options
        if o is qi
            change answer to k
        end
        change k to k + 1
    end
    give back {"prompt": vocab[qi]["va"], "root": vocab[qi]["root"], "options": options, "answer": answer}
end

to api(path, q)
    if path is "/api/all"
        give back cors_json({"vocab": vocab, "vowels": vowels, "suffixes": suffixes, "laws": laws, "stories": stories, "glyphs": glyphs})
    end
    if path is "/api/glyphs"
        give back cors_json(glyphs)
    end
    if path is "/api/words"
        give back cors_json(vocab)
    end
    if path is "/api/shift"
        let w be ""
        if "word" is in q
            change w to trim(lowercase(q["word"]))
        end
        let pos be "noun"
        if "pos" is in q
            change pos to q["pos"]
        end
        let core be core_lookup(w)
        let cf be ""
        if core is not nothing
            change cf to core
        end
        give back cors_json({"english": w, "vaeldric": vel_shift(w, suffix_for(pos)), "core": cf})
    end
    if path is "/api/quiz"
        give back cors_json(make_question())
    end
    if path is "/api/translate"
        let text be ""
        if "text" is in q
            change text to q["text"]
        end
        let dir be "en2va"
        if "dir" is in q
            change dir to q["dir"]
        end
        let result be ""
        if dir is "va2en"
            change result to va_to_en(text)
        otherwise
            change result to en_to_va(text)
        end
        give back cors_json({"input": text, "output": result, "dir": dir})
    end
    if path is "/api/coin"
        let word be ""
        if "word" is in q
            change word to q["word"]
        end
        give back cors_json(coin(word))
    end
    if path is "/api/coinages"
        let gallery be []
        for each cw in coin_words
            add coin(cw) to gallery
        end
        give back cors_json(gallery)
    end
    give back {"status": 404, "body": {"error": "no such endpoint"}, "type": "application/json", "headers": {"Access-Control-Allow-Origin": "*"}}
end

to handle(req)
    let path be req["path"]
    let q be req["query"]
    if length(path) is at least 5 and path[0:5] is "/api/"
        give back api(path, q)
    end
    if path is "/"
        give back page("Home", home_body())
    end
    if path is "/alphabet"
        give back page("Sounds", alphabet_body())
    end
    if path is "/shift"
        give back page("Vel Shift", shift_body(q))
    end
    if path is "/grammar"
        give back page("Grammar", grammar_body())
    end
    if path is "/words"
        give back page("Words", words_body())
    end
    if path is "/read"
        give back page("Read", read_body())
    end
    if path is "/quiz"
        give back page("Quiz", quiz_body(q))
    end
    give back {"status": 404, "body": page("Lost", "<h1>Naen paethael</h1><p>No such path. <a href='/'>Return home</a>.</p>")}
end

say "Vaeldric lesson site - open http://localhost:8080"
serve(8080, handle)
