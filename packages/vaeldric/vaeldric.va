add {"en": "future tense", "va": "veld", "pos": "Function", "root": "Tense particle; vel + eld"} to vocab

# ---- Second Edition endings ------------------------------------------
# Distinct endings per part of speech replace the old all-'ae' suffixes:
#   noun  -en   verb  -eth   adjective  -er   adverb  -es
#   plural -eni   comparative -ern   superlative -erst
# Pronouns, function words and a few irregular core verbs keep their forms.
let protected be {}
for each pv in vocab
    if pv["pos"] is "Pronoun" or pv["pos"] is "Function"
        let pk be pv["va"]
        change protected at pk to yes
    end
end

to respell(va)
    let tail be ""
    let core be va
    while length(core) is over 0 and not (core[length(core) - 1] is in "abcdefghijklmnopqrstuvwxyz")
        change tail to core[length(core) - 1] + tail
        change core to core[0:length(core) - 1]
    end
    if core is in protected
        give back va
    end
    let n be length(core)
    let built be core
    if ends_with(core, "aeli")
        change built to core[0:n - 4] + "eni"
    otherwise if ends_with(core, "aerst")
        change built to core[0:n - 5] + "erst"
    otherwise if ends_with(core, "aern")
        change built to core[0:n - 4] + "ern"
    otherwise if ends_with(core, "ael")
        change built to core[0:n - 3] + "en"
    otherwise if ends_with(core, "eil")
        change built to core[0:n - 3] + "eth"
    otherwise if ends_with(core, "aer")
        change built to core[0:n - 3] + "er"
    otherwise if ends_with(core, "aev")
        change built to core[0:n - 3] + "es"
    end
    give back built + tail
end

to respell_text(text)
    let out be []
    for each w in split(text, " ")
        add respell(w) to out
    end
    give back join(out, " ")
end

# rewrite the core vocabulary's content words to the new endings
for each ent in vocab
    if ent["pos"] is "Noun" or ent["pos"] is "Verb" or ent["pos"] is "Adjective"
        let nv be respell(ent["va"])
        change ent at "va" to nv
    end
end

# ---- structured content (shared by the HTML pages and the JSON API) -

let vowels be []
add {"sound": "/a/", "spell": "a", "like": "'a' in father"} to vowels
add {"sound": "/ae/", "spell": "ae", "like": "'a' in day, held long - the signature vowel"} to vowels
add {"sound": "/e/", "spell": "e", "like": "'e' in bed"} to vowels
add {"sound": "/i/", "spell": "i", "like": "'i' in bit"} to vowels
add {"sound": "/ei/", "spell": "ei", "like": "'ay-il', a true diphthong"} to vowels
add {"sound": "/o/", "spell": "o", "like": "'o' in more"} to vowels
add {"sound": "/u/", "spell": "u", "like": "'oo' in moon"} to vowels

let suffixes be []
add {"suffix": "-en", "class": "noun", "say": "en, as in 'pen'", "note": "plural becomes -eni"} to suffixes
add {"suffix": "-eth", "class": "verb", "say": "eth, as in 'breath'", "note": "never conjugates"} to suffixes
add {"suffix": "-er", "class": "adjective", "say": "er, as in 'her'", "note": "comparative -ern, superlative -erst"} to suffixes
add {"suffix": "-es", "class": "adverb", "say": "es, as in 'less'", "note": "the English '-ly'"} to suffixes

let laws be []
add {"name": "I - Word order", "rule": "Subject then Verb then Object. Always.", "ex": "Mael luveth tael. = I love you."} to laws
add {"name": "II - No conjugation", "rule": "Verbs end in -eth and never change for person or number.", "ex": "mael / herel / wael luveth = I / he / we love."} to laws
add {"name": "III - Tense by particle", "rule": "eld (past) or veld (future) before the verb; nothing means present.", "ex": "Mael eld / [-] / veld itewreth = I wrote / write / will write."} to laws
add {"name": "IV - Plural by -eni", "rule": "Change the noun ending -en to -eni.", "ex": "worden becomes wordeni = word becomes words."} to laws
add {"name": "V - Questions by kael", "rule": "Begin a sentence with kael; do not invert word order.", "ex": "Kael tael witten tha paethen? = Do you know the path?"} to laws
add {"name": "VI - Negation by naen", "rule": "Place naen directly before what you negate.", "ex": "Mael naen willen. = I do not want."} to laws
add {"name": "VII - Possession by aev", "rule": "Possessor + aev + the thing possessed.", "ex": "mael aev gaesten = my soul (I-of soul)."} to laws

let s1 be []
add {"va": "Tha paethael isen longaer.", "en": "The path is long.", "gloss": "tha = the | paethael = path | isen = is | longaer = long"} to s1
add {"va": "Mael naen witten hierael tha paethael vendael.", "en": "I do not know where the path ends.", "gloss": "naen = not | witten = know | hierael = here | vendael = end (shift of 'end')"} to s1
add {"va": "Naevel mael alkweil aeverael.", "en": "But I walk always.", "gloss": "naevel = but | alkweil = walk | aeverael = always"} to s1
add {"va": "Tha soothael liveil inael tha alkweil.", "en": "The truth lives in the walking.", "gloss": "soothael = truth | liveil = lives | inael = in"} to s1
add {"va": "Mael aev ordhael isen mael aev heortael.", "en": "My door is my heart.", "gloss": "mael aev ordhael = my door | heortael = heart"} to s1

let s2 be []
add {"va": "Vaen tha daegel aev mael aev naemael, tha worldael eld isen bierhtaer aend ilentaer.", "en": "On the day of my naming, the world was bright and silent.", "gloss": "vaen = on (shift) | daegel = day | bierhtaer = bright | ilentaer = silent"} to s2
add {"va": "Shael eld eakspeil tha naemael aen timel, tov timel, oruth timel.", "en": "She spoke the name once, twice, three times.", "gloss": "eakspeil = spoke | aen/tov/oruth timel = one/two/three times"} to s2
add {"va": "Eakspeil itel inael tha dimmaer aend itel veld ecumeib tael aev liehtael.", "en": "Speak it into the dark and it will become your light.", "gloss": "veld = future | ecumeib = become | liehtael = light"} to s2

let s3 be []
add {"va": "Shael eld nimel tha paethael.", "en": "She took the path.", "gloss": "nimel = took | paethael = path"} to s3
add {"va": "Shael eld makeil tha virstael epsteil.", "en": "She made the first step.", "gloss": "makeil = made | virstael = first | epsteil = step"} to s3
add {"va": "Tha worldael eld ecumeib magnaerst.", "en": "The world became greatest.", "gloss": "ecumeib = became | magnaerst = greatest (superlative)"} to s3
add {"va": "Tha paethael isen aeverael longaer. Naevel tha liehtael isen aeverael bierhtaerst.", "en": "The path is always long. But the light is always brightest.", "gloss": "aeverael = always | bierhtaerst = brightest"} to s3

let stories be []
add {"title": "Tha Paethael", "subtitle": "( The Path )", "lines": s1} to stories
add {"title": "Tha Daegel aev Naemael", "subtitle": "( The Day of the Name )", "lines": s2} to stories
add {"title": "Tha Inael aev Liehtael", "subtitle": "( Into the Light )", "lines": s3} to stories

# rewrite the stories (and their titles) to the new endings too
for each st in stories
    let rt be respell_text(st["title"])
    change st at "title" to rt
    for each ln in st["lines"]
        let rv be respell_text(ln["va"])
        change ln at "va" to rv
    end
end

# Vaelscript — the original writing system. Each letter's authoritative form
# description (the SVG drawing of each glyph lives in the front end, keyed by id).
let glyphs be []
add {"id": "a", "name": "Ael", "latin": "A", "desc": "A stave crowned with an upward chevron - a peak rising from the stem."} to glyphs
add {"id": "b", "name": "Bael", "latin": "B", "desc": "A stave bearing a forward flag, a sharp triangle pointing right, near the top."} to glyphs
add {"id": "d", "name": "Daeven", "latin": "D", "desc": "A stave bearing a backward flag, a triangle pointing left, near the top."} to glyphs
add {"id": "e", "name": "Eiren", "latin": "E", "desc": "A stave crowned with a downward chevron - a valley folding into the stem."} to glyphs
add {"id": "f", "name": "Faevel", "latin": "F", "desc": "A stave with two short twigs rising to the right, one above the other."} to glyphs
add {"id": "g", "name": "Gaest", "latin": "G", "desc": "A free-standing saltire - two strokes crossed, with no stave."} to glyphs
add {"id": "h", "name": "Haeth", "latin": "H", "desc": "A stave with twin twigs rising to both sides from its centre."} to glyphs
add {"id": "i", "name": "Ieven", "latin": "I", "desc": "A single bare stave - the simplest letter."} to glyphs
add {"id": "k", "name": "Kaeven", "latin": "K / C / Q", "desc": "A stave with a forward flag at its centre. C, K and Q share this one letter."} to glyphs
add {"id": "l", "name": "Laevel", "latin": "L", "desc": "A stave with a single twig falling to the right at its foot."} to glyphs
add {"id": "m", "name": "Maevel", "latin": "M", "desc": "A stave bearing two forward flags, stacked one above the other."} to glyphs
add {"id": "n", "name": "Nael", "latin": "N", "desc": "A stave with one twig falling to the right near the top."} to glyphs
add {"id": "o", "name": "Oeven", "latin": "O", "desc": "A stave pierced through its centre by a standing diamond."} to glyphs
add {"id": "p", "name": "Paeven", "latin": "P", "desc": "A stave bearing a backward flag low on the stem."} to glyphs
add {"id": "r", "name": "Raeth", "latin": "R", "desc": "A stave with a forward flag above and a falling leg below."} to glyphs
add {"id": "s", "name": "Saevel", "latin": "S", "desc": "A free-standing zigzag - the lightning letter, drawn with no stave."} to glyphs
add {"id": "t", "name": "Taeth", "latin": "T", "desc": "A stave crowned with a single horizontal bar."} to glyphs
add {"id": "u", "name": "Ueven", "latin": "U", "desc": "A stave with an upward chevron rising from its foot."} to glyphs
add {"id": "v", "name": "Vaeld", "latin": "V", "desc": "A stave with a centred upward chevron. The marker letter of Vaeldric, drawn first."} to glyphs
add {"id": "w", "name": "Waeven", "latin": "W", "desc": "A stave bearing two upward chevrons, stacked one above the other."} to glyphs
add {"id": "y", "name": "Yaevel", "latin": "Y", "desc": "A stave forking into two twigs that rise from the top."} to glyphs
add {"id": "z", "name": "Zaeven", "latin": "Z", "desc": "A stave crossed by a saltire near its top."} to glyphs
add {"id": "th", "name": "Thaevel", "latin": "TH", "desc": "A stave clasped at its centre by a lens - two facing bows. The thorn letter."} to glyphs
add {"id": "ae", "name": "Aeven", "latin": "AE", "desc": "A stave bearing two standing diamonds, high and low. The vowel ligature."} to glyphs

# ---- translator tables ----------------------------------------------
# Inflected English forms (plurals, tenses, possessives) that map onto a core
# Vaeldric word. Format: "en1,en2,...=vaeldric".
let extra_src be []
add "is,am,are,be,been,being,was,were=isen" to extra_src
add "has,had,having=havel" to extra_src
add "goes,going,gone,went=gailen" to extra_src
add "comes,coming,came=cumel" to extra_src
add "knows,knew,known,knowing=witten" to extra_src
add "says,said,speaks,spoke,speaking,saying,spoken=eakspeil" to extra_src
add "wants,wanted,wanting=willen" to extra_src
add "sees,saw,seen,seeing=sielen" to extra_src
add "does,doing,done,makes,making,made=makeil" to extra_src
add "gives,gave,given,giving=giveil" to extra_src
add "takes,took,taken,taking=nimel" to extra_src
add "feels,felt,feeling=feeleil" to extra_src
add "loves,loved,loving=luveil" to extra_src
add "thinks,thought,thinking=inktheil" to extra_src
add "writes,wrote,written,writing=itewreil" to extra_src
add "walks,walked,walking=alkweil" to extra_src
add "lives,lived,living=liveil" to extra_src
add "becomes,became,becoming=ecumeib" to extra_src
add "begins,began,beginning=vagineil" to extra_src
add "my,mine=mael" to extra_src
add "your,yours=tael" to extra_src
add "his=herel" to extra_src
add "hers=shael" to extra_src
add "its=itel" to extra_src
add "our,ours=wael" to extra_src
add "their,theirs=thael" to extra_src
add "this,that,these,those=tha" to extra_src
add "of,from=aev" to extra_src
add "with,together=midael" to extra_src
add "into=inael" to extra_src

let extra be {}
for each row in extra_src
    let pair be split(row, "=")
    let va be pair[1]
    for each en in split(pair[0], ",")
        let ekey be trim(en)
        change extra at ekey to va
    end
end
# new endings for the inflection map too
for each ek in keys(extra)
    let ev be respell(extra[ek])
    change extra at ek to ev
end

# reverse map: Vaeldric word -> primary English meaning (for VA -> EN)
let va_en be {}
for each entry in vocab
    let parts be split(entry["en"], "/")
    let vkey be entry["va"]
    let ven be trim(parts[0])
    change va_en at vkey to ven
end

# ---- the coinage engine: new words from old roots --------------------
# Vaeldric never borrows a modern word; it COINS one by compounding native
# roots, the Old English / Icelandic way (phone = far-voice). Each row is
# "english,aliases | first-root-stem | second-root-word | literal gloss".
# New building-block roots (from Old English): feor=far, scy=sky, rime=number
# (OE rim), iren=iron, fleog=fly, sweg=sound, lic=likeness, cist=chest/box,
# craet=cart, hweol=wheel, bat=boat, steor=star, maegen=might, werc=work,
# staef=staff, webb=web, eage=eye, hael=heal, arwe=arrow.
let coin_src be []
add "phone,telephone,cellphone|feor|oisvael|far-voice" to coin_src
add "airplane,aeroplane,plane,jet|scy|batael|sky-boat" to coin_src
add "computer|rime|mindael|number-mind" to coin_src
add "television,tv|feor|sielael|far-sight" to coin_src
add "car,automobile,auto|self|craetael|self-cart" to coin_src
add "radio|scy|oisvael|sky-voice" to coin_src
add "clock,watch|tim|hoeldael|time-holder" to coin_src
add "electricity|fier|maegenael|fire-might" to coin_src
add "machine,engine,motor|iren|wercael|iron-work" to coin_src
add "camera|lic|cistael|likeness-box" to coin_src
add "gun,rifle|fier|staefael|fire-staff" to coin_src
add "train|iren|craetael|iron-cart" to coin_src
add "rocket,missile|fier|arwael|fire-arrow" to coin_src
add "spaceship,spacecraft|steor|batael|star-boat" to coin_src
add "robot|iren|selfael|iron-self" to coin_src
add "internet,web,network|word|webbael|word-web" to coin_src
add "map|verth|licael|earth-likeness" to coin_src
add "glasses,spectacles|eag|glaesael|eye-glass" to coin_src
add "doctor,physician|laef|haelael|life-healer" to coin_src
add "music,song|sweg|craeftael|sound-craft" to coin_src
add "bicycle,bike|tov|hweolael|two-wheel" to coin_src
