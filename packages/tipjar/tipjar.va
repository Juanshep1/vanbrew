let html be "<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Tip Jar</title>"
change html to html + "<link href='https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@1,9..144,600&family=Space+Mono:wght@400;700&family=DM+Sans:wght@400;500;700&display=swap' rel='stylesheet'>"
change html to html + "<style>"
change html to html + "*{{box-sizing:border-box;margin:0;padding:0}}html,body{{height:100%}}"
change html to html + "body{{font-family:'DM Sans',system-ui,sans-serif;background:linear-gradient(120deg,#ff7a59,#ff5e8a,#7a3cff,#2a9df4);background-size:300% 300%;animation:flow 16s ease infinite;overflow:hidden}}"
change html to html + "@keyframes flow{{0%{{background-position:0% 50%}}50%{{background-position:100% 50%}}100%{{background-position:0% 50%}}}}"
change html to html + ".card{{position:fixed;left:calc(50% - 190px);top:13%;width:380px;background:rgba(20,16,28,.72);backdrop-filter:blur(22px) saturate(1.3);border:1px solid rgba(255,255,255,.14);border-radius:24px;box-shadow:0 30px 80px rgba(0,0,0,.45);color:#f5f0ff;overflow:hidden}}"
change html to html + ".head{{display:flex;align-items:center;gap:10px;padding:18px 22px;cursor:grab;background:linear-gradient(180deg,rgba(255,255,255,.08),transparent);user-select:none}}.head:active{{cursor:grabbing}}"
change html to html + ".head .emoji{{font-size:22px}}.head h1{{font-family:'Fraunces',serif;font-style:italic;font-weight:600;font-size:22px}}.head .dots{{margin-left:auto;display:flex;gap:6px}}.dot{{width:10px;height:10px;border-radius:50%;background:rgba(255,255,255,.18)}}"
change html to html + ".body{{padding:6px 22px 22px}}label{{display:block;font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:#b9aed4;margin:18px 0 8px}}"
change html to html + ".bill{{display:flex;align-items:center;gap:8px;background:rgba(0,0,0,.3);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:10px 16px}}.bill span{{font-family:'Space Mono',monospace;font-size:24px;color:#ffd166}}.bill input{{flex:1;background:transparent;border:0;outline:0;color:#f5f0ff;font-family:'Space Mono',monospace;font-size:26px;width:100%}}"
change html to html + ".tips{{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}}.tip{{padding:12px 0;text-align:center;border-radius:12px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);cursor:pointer;font-weight:700;transition:.15s}}.tip:hover{{background:rgba(255,255,255,.14)}}.tip.on{{background:#5ef0c0;color:#04261d;border-color:#5ef0c0;box-shadow:0 6px 20px rgba(94,240,192,.4)}}"
change html to html + ".split{{display:flex;align-items:center;gap:14px}}.step{{display:flex;align-items:center;background:rgba(0,0,0,.3);border:1px solid rgba(255,255,255,.1);border-radius:12px;overflow:hidden}}.step button{{width:42px;height:42px;background:transparent;border:0;color:#f5f0ff;font-size:22px;cursor:pointer}}.step button:hover{{background:rgba(255,255,255,.12)}}.step .n{{width:46px;text-align:center;font-family:'Space Mono',monospace;font-size:20px}}"
change html to html + ".out{{margin-top:22px;border-top:1px dashed rgba(255,255,255,.18);padding-top:16px;display:grid;gap:12px}}.row{{display:flex;justify-content:space-between;align-items:baseline}}.row .k{{color:#b9aed4;font-size:13px}}.row .v{{font-family:'Space Mono',monospace;font-size:20px}}.row.total .v{{font-size:30px;color:#5ef0c0}}.row.each .v{{font-size:24px;color:#ffd166}}"
change html to html + ".reset{{margin-top:18px;width:100%;padding:12px;border:0;border-radius:12px;background:rgba(255,255,255,.08);color:#b9aed4;cursor:pointer;font:inherit;letter-spacing:1px}}.reset:hover{{background:rgba(255,255,255,.14);color:#f5f0ff}}"
change html to html + "</style></head><body>"
change html to html + "<div class='card' id='card'><div class='head' id='head'><span class='emoji'>&#129534;</span><h1>Tip Jar</h1><div class='dots'><i class='dot'></i><i class='dot'></i><i class='dot'></i></div></div>"
change html to html + "<div class='body'><label>Bill amount</label><div class='bill'><span>$</span><input id='bill' type='number' inputmode='decimal' placeholder='0.00' value='42.00'></div>"
change html to html + "<label>Tip</label><div class='tips' id='tips'><div class='tip' data-t='10'>10%</div><div class='tip' data-t='15'>15%</div><div class='tip on' data-t='18'>18%</div><div class='tip' data-t='20'>20%</div><div class='tip' data-t='25'>25%</div></div>"
change html to html + "<label>Split between</label><div class='split'><div class='step'><button id='minus'>-</button><div class='n' id='people'>1</div><button id='plus'>+</button></div><span style='color:#b9aed4;font-size:13px'>people</span></div>"
change html to html + "<div class='out'><div class='row'><span class='k'>Tip</span><span class='v' id='tipAmt'>$0.00</span></div><div class='row total'><span class='k'>Total</span><span class='v' id='total'>$0.00</span></div><div class='row each'><span class='k'>Each person pays</span><span class='v' id='each'>$0.00</span></div></div>"
change html to html + "<button class='reset' id='reset'>RESET</button></div></div>"
change html to html + "<script>"
change html to html + "var bill=document.getElementById('bill'),tips=document.getElementById('tips'),peopleEl=document.getElementById('people');var tip=18,people=1;"
change html to html + "function money(n){{return '$'+(isFinite(n)?n:0).toFixed(2);}}"
change html to html + "function calc(){{var b=parseFloat(bill.value)||0;var t=b*tip/100;var tot=b+t;document.getElementById('tipAmt').textContent=money(t);document.getElementById('total').textContent=money(tot);document.getElementById('each').textContent=money(tot/people);}}"
change html to html + "tips.addEventListener('click',function(e){{var el=e.target.closest('.tip');if(!el)return;tip=parseFloat(el.getAttribute('data-t'));[].forEach.call(tips.children,function(c){{c.classList.remove('on');}});el.classList.add('on');calc();}});"
change html to html + "bill.addEventListener('input',calc);"
change html to html + "document.getElementById('plus').addEventListener('click',function(){{people++;peopleEl.textContent=people;calc();}});"
change html to html + "document.getElementById('minus').addEventListener('click',function(){{if(people>1){{people--;peopleEl.textContent=people;calc();}}}});"
change html to html + "document.getElementById('reset').addEventListener('click',function(){{bill.value='';tip=18;people=1;peopleEl.textContent=1;[].forEach.call(tips.children,function(c){{c.classList.toggle('on',c.getAttribute('data-t')==='18');}});calc();bill.focus();}});"
change html to html + "var card=document.getElementById('card'),head=document.getElementById('head');"
change html to html + "head.addEventListener('mousedown',function(e){{var sx=e.clientX,sy=e.clientY,r=card.getBoundingClientRect(),ox=r.left,oy=r.top;function mv(ev){{card.style.left=(ox+ev.clientX-sx)+'px';card.style.top=(oy+ev.clientY-sy)+'px';}}function up(){{document.removeEventListener('mousemove',mv);document.removeEventListener('mouseup',up);}}document.addEventListener('mousemove',mv);document.addEventListener('mouseup',up);}});"
change html to html + "calc();bill.select();"
change html to html + "</script></body></html>"
let dest be path_join(home_dir(), "tip_jar.html")
write_file(dest, html)
open_url("file://" + dest)
say "Tip Jar opened - drag it by the header!"
