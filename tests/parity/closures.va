# Anonymous functions, closures, slicing, and constants.

# anonymous functions (make PARAMS give EXPR)
let double be make x give x * 2
assert(double(21) is 42, "lambda value")
assert(to_json(map(make n give n * n, [1, 2, 3])) is "[1, 4, 9]", "lambda into map")
assert(to_json(keep(make n give n % 2 is 0, range(0, 6))) is "[0, 2, 4]", "lambda into keep")

# closures capture the defining scope
to multiplier(factor)
    give back make x give x * factor
end
let triple be multiplier(3)
let times10 be multiplier(10)
assert(triple(5) is 15, "closure captures factor")
assert(times10(5) is 50, "each closure is independent")
assert(triple(5) is 15, "closures don't interfere")

# nested named function as a stateful closure
to make_counter()
    let count be 0
    to bump()
        increase count by 1
        give back count
    end
    give back bump
end
let c be make_counter()
assert(c() is 1, "counter closure 1")
assert(c() is 2, "counter closure 2")
let c2 be make_counter()
assert(c2() is 1, "fresh counter is independent")

# slicing
let xs be [0, 1, 2, 3, 4, 5]
assert(to_json(xs[1:3]) is "[1, 2]", "slice middle")
assert(to_json(xs[3:]) is "[3, 4, 5]", "slice to end")
assert(to_json(xs[:2]) is "[0, 1]", "slice from start")
assert(to_json(xs[:]) is "[0, 1, 2, 3, 4, 5]", "slice whole")
assert(to_json(xs[-2:]) is "[4, 5]", "slice negative start")
assert("vanta"[1:4] is "ant", "slice text")

# constants
fix limit be 100
assert(limit is 100, "fix defines a value")
let caught be no
attempt
    change limit to 200
rescue e
    change caught to yes
    assert("fixed" is in e, "changing a fixed value errors")
end
assert(caught, "constant could not be reassigned")

say "closure and slice tests passed"
