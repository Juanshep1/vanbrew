# Lists, maps, and the higher-order functions over them.

to dbl(n)
    give back n * 2
end

to odd(n)
    give back n % 2 is 1
end

to summer(a, b)
    give back a + b
end

let xs be [3, 1, 2]
assert(length(xs) is 3, "list length")
assert(xs[0] is 3, "index")
assert(first(xs) is 3, "first")
assert(last(xs) is 2, "last")
add 4 to xs
assert(last(xs) is 4, "add to")
change xs at 0 to 9
assert(xs[0] is 9, "change at")
assert(to_json(sort([3, 1, 2])) is "[1, 2, 3]", "sort")
assert(to_json(reverse([1, 2, 3])) is "[3, 2, 1]", "reverse")
assert(to_json(slice([1, 2, 3, 4], 1, 3)) is "[2, 3]", "slice")
assert(to_json(range(3)) is "[0, 1, 2]", "range")
assert(contains([1, 2, 3], 2), "list contains")
assert(join(["a", "b", "c"], "-") is "a-b-c", "join")

push(xs, 7)
assert(last(xs) is 7, "push")
assert(pop(xs) is 7, "pop")

let m be { "a": 1, "b": 2 }
assert(m["a"] is 1, "map get")
change m at "c" to 3
assert(m["c"] is 3, "map set")
assert(length(keys(m)) is 3, "keys")
assert(contains(m, "b"), "map contains")
assert(to_json(values({ "x": 10 })) is "[10]", "values")

assert(to_json(map(dbl, [1, 2, 3])) is "[2, 4, 6]", "map")
assert(to_json(keep(odd, [1, 2, 3, 4, 5])) is "[1, 3, 5]", "keep")
assert(reduce(summer, [1, 2, 3, 4], 0) is 10, "reduce")
assert(count_where(odd, [1, 2, 3, 4, 5]) is 3, "count_where")
assert(find_where(odd, [2, 4, 5, 6]) is 5, "find_where")
assert(to_json(sort_by(dbl, [3, 1, 2])) is "[1, 2, 3]", "sort_by")

say "collection tests passed"
